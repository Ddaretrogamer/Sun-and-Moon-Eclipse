script Ikitown_trigger_GiveHalaSparklingStone{
    lock
    startcutscene(CUTSCENE_IKITOWN_GIVE_HALA_SPARKLING_STONE)
    speakername("Hau")
    msgbox("Oh yeah! {PLAYER}!
    Hold up a sec!", MSGBOX_AUTOCLOSE)
    playse(SE_PIN)
    applymovement(LOCALID_PLAYER, moves(emote_question_mark))
    waitmovement(0)
    fadescreenswapbuffers(FADE_TO_BLACK)
    setobjectxy(ikitownhala, 24, 12)
    setobjectxy(ikitownintrokukui2, 23, 12)
    applymovement(ikitownhala, moves(face_down))
    applymovement(ikitownintrokukui2, moves(face_down))
    applymovement(ikitownlillie, moves(face_right))
    waitmovement(0)
    getplayerxy(VAR_TEMP_1, VAR_TEMP_2)
    if (var(VAR_TEMP_1) == 28 && var(VAR_TEMP_2) == 14){
        applymovement(LOCALID_PLAYER, moves(walk_faster_left*4))
        waitmovement(0)
        addobject(ikitownintrohau)
        setobjectxy(ikitownintrohau, 27, 15)
        applymovement(ikitownintrohau, moves(walk_faster_left*11))
        waitmovement(0)
    }
    if (var(VAR_TEMP_1) == 28 && var(VAR_TEMP_2) == 15){
        applymovement(LOCALID_PLAYER, moves(walk_faster_left*4, walk_faster_up, face_left))
        waitmovement(0)
        addobject(ikitownintrohau)
        setobjectxy(ikitownintrohau, 27, 15)
        applymovement(ikitownintrohau, moves(walk_faster_left*11))
        waitmovement(0)
    }
    if (var(VAR_TEMP_1) == 17 && var(VAR_TEMP_2) == 14){
        applymovement(LOCALID_PLAYER, moves(walk_faster_right*7, face_left))
        waitmovement(0)
        addobject(ikitownintrohau)
        setobjectxy(ikitownintrohau, 16, 15)
    }
    if (var(VAR_TEMP_1) == 17 && var(VAR_TEMP_2) == 15){
        applymovement(LOCALID_PLAYER, moves(walk_faster_right*7, walk_faster_up, face_left))
        waitmovement(0)
        addobject(ikitownintrohau)
        setobjectxy(ikitownintrohau, 16, 15)
    }
    delay(30)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    applymovement(ikitownintrohau, moves(walk_right, walk_diag_northeast, walk_right*2))
    delay(60)
    applymovement(ikitownhala, moves(walk_down, delay_8, face_left))
    waitmovement(0)
    applymovement(ikitownlillie, moves(face_right))
    waitmovement(0)
    speakername("Hala")
    msgbox("What is it Hau? Did you forget
    something?")
    applymovement(ikitownintrohau, moves(walk_in_place_right*2))
    waitmovement(0)
    speakername("Hau")
    msgbox("You're seriously asking me that?!
    
    Who's the one here who forgot to tell
    anyone before wandering off for a
    little stroll and a sing without a
    word, huh?")
    setvar(VAR_RESULT, 1)
    playse(SE_M_DETECT)
    dofieldeffectsparkle(24, 14, 0)
    waitfieldeffect(FLDEFF_SPARKLE)
    closemessage
    playse(SE_PIN)
    applymovement(ikitownhala, moves(emote_exclamation_mark))
    waitmovement(0)
    applymovement(ikitownhala, moves(face_down))
    applymovement(LOCALID_PLAYER, moves(face_up))
    waitmovement(0)
    speakername("Hala")
    msgbox("Hm?
    {PLAYER}\.
    
    Would you be so kind as to give me a
    look at that {COLOR RED}Sparkling Stone{COLOR DARK_GRAY} you
    have there?")
    applymovement(LOCALID_PLAYER, moves(walk_in_place_up*2))
    waitmovement(0)
    speakername("Hala")
    msgbox("Could it be?!")
    applymovement(ikitownintrohau, moves(walk_in_place_right*2))
    waitmovement(0)
    speakername("Hau")
    msgbox("Tutu, isn't that\.")
    applymovement(ikitownhala, moves(walk_in_place_down*2))
    waitmovement(0)
    speakername("Hala")
    msgbox("You were rescued by Tapu Koko at the
    bridge-isn't that what I heard,
    {PLAYER}?")
    dynmultichoice(18,8,TRUE, 5, 0, DYN_MULTICHOICE_CB_NONE, "Yeah, it rescued me", "It gave me a stone")
    if (var(VAR_RESULT) == 0){
        speakername("Hala")
        msgbox("So it even deigned to give you a stone\.
        
        Perhaps you are here in Alola,
        {PLAYER}, because this is where
        you are meant to be.
        
        Allow me to borrow this stone for now.
        
        Fret not, I will return it to you
        tomorrow evening.
        
        You have the makings of a brilliant
        Trainer.
        I can see that light within you, too.
        
        You must do us the honor of joining in
        our festival tomorrow!")
    }
    else{
        speakername("Hala")
        msgbox("So it even deigned to give you a stone\.
        
        Perhaps you are here in Alola,
        {PLAYER}, because this is where
        you are meant to be.
        
        Allow me to borrow this stone for now.
        
        Fret not, I will return it to you
        tomorrow evening.
        
        You have the makings of a brilliant
        Trainer.
        I can see that light within you, too.
        
        You must do us the honor of joining in
        our festival tomorrow!")
    }
    applymovement(ikitownintrokukui2, moves(walk_down))
    waitmovement(0)
    speakername("Kukui")
    msgbox("First I'll make sure you get back home
    safe today, though, {PLAYER}.")
    applymovement(ikitownintrokukui2, moves(face_left))
    msgbox("Lillie, you two should come with us
    too, yeah.
    
    Wouldn't want to go losing you twice
    in one day.
    You or that precious Pokémon of yours!")
    applymovement(ikitownlillie, moves(walk_in_place_right*2))
    waitmovement(0)
    speakername("Lillie")
    msgbox("Yes\.
    I will key an eye on Nebby")
    fadescreenswapbuffers(FADE_TO_BLACK)
    setflag(FLAG_HIDE_IKITOWN_HALA)
    setflag(FLAG_HIDE_IKITOWN_INTRO_HAU)
    setvar(VAR_IKITOWN_STATE, 8)
    setvar(VAR_HAUOLI_OUTSKIRTS_STATE, 1)
    setflag(FLAG_HAUOLI_OUTSKIRTS_NEWGAME)
    setflag(FLAG_MOM_IN_HOUSE_INTRO)
    clearflag(FLAG_HIDE_PLAYER_MOM3)
    removeitem(ITEM_SPARKLING_STONE, 1)
    endcutscene
    warp(MAP_PLAYER_HOUSE, 8, 15)
    waitstate
}

