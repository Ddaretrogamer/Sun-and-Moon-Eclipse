script Ikitown_GetPokedex{
    lock
    startcutscene(CUTSCENE_IKITOWN_GET_POKEDEX)
    applymovement(ikitownlillie, moves(walk_down*6, walk_left*6, walk_down*4, walk_diag_northeast, walk_right*3, walk_up, face_right))
    applymovement(LOCALID_PLAYER, moves(delay_16*3, walk_down*6, walk_left*5, walk_down*4, walk_diag_northeast, walk_right*3))
    waitmovement(0)
    playse(SE_PIN)
    applymovement(ikitownintrokukui2, moves(emote_exclamation_mark, walk_down, face_left))
    waitmovement(0)
    speakername("Kukui")
    msgbox("Oh, {PLAYER}!
    You already met Lillie, huh?

    She's my assistant, yeah!")
    applymovement(ikitownintrokukui2, moves(walk_in_place_left*2))
    waitmovement(0)
    msgbox("Lillie, I thought you were with the
    kahuna?")
    applymovement(ikitownlillie, moves(walk_in_place_right*2))
    waitmovement(0)
    speakername("Lillie")
    msgbox("Kahuna Hala? He said that he had
    something to attend to, so he left
    town on his own.
    
    I was just, um, taking a little stroll
    up Mahalo Trail while I waited for
    him to return\.")
    checkplayergender
    if (var(VAR_RESULT) == 0){
        speakername("Kukui")
        msgbox("And that's how you met our new neighbor
        {PLAYER}, huh?
        
        He just got to Alola yesterday.
        Help him find his way around, yeah?")
    }
    else{
        speakername("Kukui")
        msgbox("And that's how you met our new neighbor
        {PLAYER}, huh?
        
        She just got to Alola yesterday.
        Help her find her way around, yeah?")
    }
    applymovement(ikitownlillie, moves(walk_in_place_down*2))
    waitmovement(0)
    speakername("Lillie")
    msgbox("So\.you're also one of
    the professor's acquaintances?
    
    It's nice to meet you.", MSGBOX_AUTOCLOSE)
    special(SpawnCameraObject)
    delay(30)
    //fadescreenswapbuffers(FADE_TO_BLACK)
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_fast_right*8, walk_diag_northeast))
    waitmovement(0)
    applymovement(ikitownman1, moves(emote_exclamation_mark, face_down))
    applymovement(ikitownoldman1, moves(emote_exclamation_mark, face_down))
    waitmovement(0)
    setflag(FLAG_SUPPRESS_SPEAKER_NAME)
    clearflag(FLAG_SUPPRESS_SPEAKER_NAME)
    msgbox("The kahuna is back!
    Kahuna Hala has returned!
    
    Our guardian's chosen one is back!
    
    Only one of the strongest Pokémon
    users in all Alola, yeah!", MSGBOX_AUTOCLOSE)
    delay(30)
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_down, delay_16*3))
    applymovement(ikitownhala, moves(walk_up*4, face_left))
    waitmovement(0)
    speakername("Hala")
    msgbox("Have I missed something?", MSGBOX_AUTOCLOSE)
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_left*4, walk_left*3))
    waitmovement(0)
    applymovement(ikitownintrokukui2, moves(face_right))
    waitmovement(0)
    speakername("Kukui")
    msgbox("There you are, Kahuna Hala!
    Was there some kind of trouble?")
    applymovement(ikitownhala, moves(walk_left*4, walk_diag_northwest, walk_left*3))
    waitmovement(0)
    applymovement(ikitownintrokukui2, moves(face_down))
    applymovement(ikitownlillie, moves(face_right))
    speakername("Hala")
    msgbox("Ahaha! Just got caught up in the
    middle of some brawling Rockruff,
    that's all!
    
    Sorry, Lillie.
    What were you saying before?
    
    For some reason I thought I saw
    Tapu Koko flying about\.")
    applymovement(ikitownlillie, moves(walk_in_place_right*2))    
    waitmovement(0)
    speakername("Lillie")
    msgbox("Oh, um\.
    Yes, Kahuna Hala\.
    
    Nebby got attacked by some Wingull
    on the Plank Bridge.
    
    And {PLAYER} here helped protect it.
    
    But the bridge collapsed, and I thought
    both of them might fall to the
    bottom of the ravine\.
    
    And that was when the island's guardian
    deity, swooped in to save them!")
    applymovement(ikitownintrokukui2, moves(walk_in_place_left*2))
    waitmovement(0)
    speakername("Kukui")
    msgbox("Woo! That's something you don't hear
    every day!")
    applymovement(ikitownhala, moves(walk_in_place_left*2))
    waitmovement(0)
    speakername("Hala")
    msgbox("Ho! Although it is said to protect us,
    our Tapu Koko is a rather fickle
    creature.
    Yet our guardian was moved to save you.")
    applymovement(ikitownhala, moves(walk_in_place_left*2))
    waitmovement(0)
    msgbox("Kukui, my boy, I think we have
    cause to celebrate!
    
    Looks like we have a brave and kind new
    Pokémon Trainer in our midst!
    
    I'm glad to meet you, child.
    I'm Hala, the kahuna of Melemele
    Island.
    
    Welcome to Alola!
    Young Kukui had told me of your
    coming.
    
    I'm glad we had the chance to meet
    today.")
    applymovement(ikitownintrokukui2, moves(walk_down, walk_left))
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_left*2))
    waitmovement(0)
    speakername("Kukui")
    msgbox("All right, here's a lovely gift to
    help make today special {PLAYER}!")
    setvar(VAR_ROTOM_PHONE_ENABLE, 1)
    setflag(FLAG_SYS_POKEDEX_GET)
    setflag(FLAG_SUPPRESS_SPEAKER_NAME)
    playfanfare(MUS_OBTAIN_ITEM)
    msgbox("You obtained a {COLOR RED}Rotom Phone{COLOR DARK_GRAY}!")
    waitfanfare
    clearflag(FLAG_SUPPRESS_SPEAKER_NAME)
    bufferleadmonspeciesname(STR_VAR_1)
    speakername("Kukui")
    msgbox("The Rotom Phone comes equipped with a
    Pokédex, which is a really high-tech
    kinda tool, that can automatically
    record facts about any Pokémon that
    you meet.
    
    Your new partner, {STR_VAR_1} is
    already registered, oh yeah, so
    check it out!")
    // placeholder for help window on how to use the rotom phone.
    msgbox("Well, you got to meet the kahuna
    at least.
    
    Ready to head home now, {PLAYER}?", MSGBOX_AUTOCLOSE)
    special(RemoveCameraObject)
    fadescreenswapbuffers(FADE_TO_BLACK)
    applymovement(ikitownintrokukui2, moves(walk_faster_right, walk_faster_up, face_down))
    delay(60)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    setvar(VAR_IKITOWN_STATE, 7)
    endcutscene
    release
    end
}

script Ikitown_GetPokedexSkip{
    closemessage
    fadescreenswapbuffers(FADE_TO_BLACK)
    special(StopAllObjectMovements)
    special(CloseScriptMenus)
    special(HideCutsceneCinematicBars)
    special(RemoveCameraObject)
    setvar(VAR_ROTOM_PHONE_ENABLE, 1)
    setflag(FLAG_SYS_POKEDEX_GET)
    setvar(VAR_IKITOWN_STATE, 7)
    // Set player position first — SnapCameraToPlayer reads currentCoords to anchor the camera.
    setobjectxy(LOCALID_PLAYER, 21, 14)
    special(SnapCameraToPlayer)
    // THIS IS SUPER IMPORTANT OR OBJECTS WILL BE MISSING!!!!!
    // NPC setobjectxy MUST come after SnapCameraToPlayer. SetSpritePosToMapCoords bakes in
    // gTotalCameraPixelOffsetX at call time; SnapCameraToPlayer resets that offset to 0, so
    // any setobjectxy called before it would leave sprite->pos at a stale camera-panned value.
    addobject(ikitownlillie)
    addobject(ikitownhala)
    addobject(ikitownintrokukui2)
    showobjectat(LOCALID_PLAYER, MAP_IKI_TOWN)
    showobjectat(ikitownlillie, MAP_IKI_TOWN)
    showobjectat(ikitownhala, MAP_IKI_TOWN)
    showobjectat(ikitownintrokukui2, MAP_IKI_TOWN)
    setobjectxy(ikitownlillie, 21, 13)
    setobjectxy(ikitownhala, 24, 14)
    setobjectxy(ikitownintrokukui2, 23, 13)
    applymovement(LOCALID_PLAYER, moves(face_right))
    applymovement(ikitownlillie, moves(face_right))
    applymovement(ikitownhala, moves(face_left))
    applymovement(ikitownintrokukui2, moves(face_down))
    waitmovement(0)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    release
    end
}

