mapscripts Route117_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE[VAR_SECRET_ENDING, 0: Route117_secretscript]
}

script Route117_secretscript {
	lock
	hideobjectat(LOCALID_PLAYER, MAP_ROUTE117_POKEMON_DAY_CARE)
	special(SpawnCameraObject)
	applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_fast_right*15))
	applymovement(SecretEndingBrenden, moves(walk_fast_right*15))
	waitmovement(OBJ_EVENT_ID_CAMERA)
	waitmovement(SecretEndingBrenden)
	applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_fast_left*5))
	applymovement(SecretEndingBrenden, moves(walk_fast_left*5))
	waitmovement(OBJ_EVENT_ID_CAMERA)
	waitmovement(SecretEndingBrenden)
	playse(SE_PIN)
	applymovement(SecretEndingBrenden, Common_Movement_ExclamationMark)
	waitmovement(SecretEndingBrenden)
	msgbox("Huh?". MSGBOX_AUTOCLOSE)
	special(EggHatch)
	waitstate
	playfanfare(MUS_OBTAIN_TMHM)
	msgbox("You can now play as a shiny Ditto!", MSGBOX_AUTOCLOSE)
	msgbox("Start a new save to play through\nthe game completely as a shiny!\pEnjoy the new shiny Ditto themed\nUI elements as well!", MSGBOX_AUTOCLOSE)
    fadescreenspeed(FADE_TO_BLACK, 24)
    delay(60)
	special(GameClear)  
}
