mapscripts AlolaLaboratory_MapScripts {
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE[FLAG_LILLIE_INTRO_PLAYED, TRUE {
        hideobjectat(lab_rotom, MAP_ALOLA_LABORATORY)
        if (var(VAR_IKITOWN_STATE) > 18) {
            setobjectxy(lab_lillie, 14, 17)
            hideobjectat(lab_lillie, MAP_ALOLA_LABORATORY)
        }
    }]
    MAP_SCRIPT_ON_FRAME_TABLE[VAR_IKITOWN_STATE, 18: AlolaLaboratory_FirstTimeIntro]
}


script AlolaLaboratory_Kukui{
    lock
    faceplayer
    speakername("Kukui")
    msgbox("Pok\emon are my totally necessary
    partners in my research.
    
    Plus we all live here together.
    I guess I'd have to call them family!")
    release
    end
}

script AlolaLaboratory_Stufful{
    lock
    faceplayer
    playmoncry(SPECIES_STUFFUL, 0)
    msgbox("Ayoo!")
    waitmessage
    release
    end
}

script AlolaLaboratory_Snubull{
    lock
    faceplayer
    playmoncry(SPECIES_SNUBBULL, 0)
    msgbox("Wroo!")
    waitmessage
    release
    end
}

script AlolaLaboratory_Rockruff{
    lock
    faceplayer
    playmoncry(SPECIES_ROCKRUFF, 0)
    msgbox("Wroof!")
    waitmessage
    release
    end
}

script AlolaLaboratory_FirstTimeIntro{
    lock
    setvar(VAR_IKITOWN_STATE, 19)
    // setobjectmovementtype(lab_stufful, MOVEMENT_TYPE_WALK_IN_PLACE_DOWN)
    // setobjectmovementtype(lab_snubbull, MOVEMENT_TYPE_WALK_IN_PLACE_UP)
    applymovement(lab_rockruff, moves(face_right))
    applymovement(lab_kukui, moves(face_left))
    waitmovement(0)
    // startcutscene(CUTSCENE_ALOLA_LABORATORY_FIRST_TIME_INTRO)
    showobjectat(lab_lillie, MAP_ALOLA_LABORATORY)
    startcutscene(CUTSCENE_ALOLA_LABORATORY_FIRST_TIME_INTRO)
    // special(SpawnCameraObject)
    // applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_left*4))
    // waitmovement(0)
    // delay(60)
    // applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_diag_northeast*4))
    // waitmovement(0)
    // applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_up*2))
    applymovement(lab_lillie, moves(walk_up*3))
    applymovement(LOCALID_PLAYER, moves(walk_up*3))
    waitmovement(0)
    delay(60)
    playmoncry(SPECIES_ROCKRUFF, 0)
    applymovement(lab_rockruff, moves(walk_in_place_right*2))
    waitmovement(0)
    waitmoncry
    delay(30)
    playse(SE_PIN)
    applymovement(lab_kukui, moves(emote_exclamation_mark,face_down))
    applymovement(lab_rockruff, moves(delay_16*2, face_down))
    waitmovement(0)
    // delay(30)
    // applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_down*3))
    // waitmovement(0)
    delay(30)
    // special(RemoveCameraObject)
    speakername("Kukui")
    checkplayergender
    if (var(VAR_RESULT)==MALE){
        applymovement(lab_kukui, moves(jump_in_place_down*2))
        playse(SE_LEDGE)
        waitse
        playse(SE_LEDGE)
        waitse
        msgbox("Hey there, {PLAYER}!
        Thanks for getting him for me, Lillie!", MSGBOX_AUTOCLOSE)
    }
    else{
        applymovement(lab_kukui, moves(jump_in_place_down*2))
        playse(SE_LEDGE)
        waitse
        playse(SE_LEDGE)
        waitse
        msgbox("Hey there, {PLAYER}!
        Thanks for getting her for me, Lillie!", MSGBOX_AUTOCLOSE)
    }
    applymovement(lab_kukui, moves(walk_down))
    applymovement(lab_rockruff, moves(delay_8, face_down))
    waitmovement(0)
    speakername("Lillie")
    msgbox("Of course. However I can be a help\.
    I am supposed to be your assistant.")
    speakername("Kukui")
    msgbox("Rockruff's moves were just so stylin',
    and I was making good progress with
    my research.
    
    Say, {PLAYER}, lemme see your Rotom
    Phone for a second, yeah?", MSGBOX_AUTOCLOSE)
    applymovement(LOCALID_PLAYER, moves(walk_up, delay_16*2, walk_in_place_up*2))
    waitmovement(0)
    delay(30)
    applymovement(lab_kukui, moves(face_left))
    waitmovement(0)
    speakername("Kukui")
    msgbox("So what do you think of the place?
    Not bad right?", MSGBOX_AUTOCLOSE)
    playse(SE_PIN)
    applymovement(lab_lillie, moves(emote_question_mark))
    waitmovement(0)
    delay(100)
    speakername("Kukui")
    msgbox("But that's not why I called you here,
    eh?
    
    Here! It finally arrived!")
    speakername("Lillie")
    msgbox("\qoIt\qc\.?")
    applymovement(lab_kukui, moves(face_down))
    waitmovement(0)
    speakername("Kukui")
    msgbox("What's wrong, Lillie? Dont make me
    do all the talking?
    
    See, there's this Pok\emon inside your
    Phone called Rotom\.")
    dynmultichoice(20 ,8,TRUE, 5, 0, DYN_MULTICHOICE_CB_NONE, "Really?", "Rotom?")
    if (var(VAR_RESULT) == 0){
        applymovement(lab_lillie, moves(walk_in_place_up*2))
        waitmovement(0)
        speakername("Lillie")
        msgbox("Oh, I can tell you about Rotom.
        
        It's a peculiar Pok\emon, with a body
        made up of something like
        electricity.
        It can take up residence in machines.")

    }
    else{
        applymovement(lab_lillie, moves(walk_in_place_up*2))
        waitmovement(0)
        speakername("Lillie")
        msgbox("Oh, I can tell you about Rotom.
        
        It's a peculiar Pok\emon, with a body
        made up of something like
        electricity.
        It can take up residence in machines.")
    }
    applymovement(lab_kukui, moves(walk_in_place_down*2))
    speakername("Kukui")
    msgbox("Yeah, buddy! And to put that crazy skill
    of Rotom's to work\.
    
    It's the next generation of Phones, but
    it's only complete once Rotom has
    gone into this body specially
    developed for it!
    
    A whole new way for people and Pokémon
    to communicate. Woo!
    
    And there's only a few of these
    beauties out in the world so far!
    
    And now if I power up your Rotom Phone
    with the parts that I just got in\.", MSGBOX_AUTOCLOSE)
    applymovement(lab_kukui, moves(face_up, delay_16, walk_in_place_up*4))
    playse(SE_SWITCH)
    waitse
    playse(SE_SWITCH)
    waitse
    playse(SE_CLICK)
    waitse
    waitmovement(0)
    fadescreen(FADE_TO_WHITE)
    playse(SE_M_MEGA_KICK)
    waitse
    playse(SE_M_SELF_DESTRUCT)
    waitse
    playse(SE_BALL_OPEN)
    waitse
    showobjectat(lab_rotom, MAP_ALOLA_LABORATORY)
    setobjectxy(lab_rotom, 14, 11)
    fadescreen(FADE_FROM_WHITE)
    applymovement(lab_kukui, moves(face_left))
    waitmovement(0)
    setflag(FLAG_SUPPRESS_SPEAKER_NAME)
    playmoncry(SPECIES_ROTOM, 0)
    applymovement(lab_rotom, moves(walk_in_place_down*2))
    waitmovement(0)
    msgbox("\.Kzzzt?")
    waitmoncry
    waitmessage
    clearflag(FLAG_SUPPRESS_SPEAKER_NAME)
    speakername("Kukui")
    msgbox("Hey now! Sorry 'bout that, Rotom.
    Guess I surprised you?")
    setflag(FLAG_SUPPRESS_SPEAKER_NAME)
    playmoncry(SPECIES_ROTOM, 0)
    applymovement(lab_rotom, moves(walk_in_place_down*2))
    waitmovement(0)
    msgbox("Zz-zzt\.", MSGBOX_AUTOCLOSE)
    waitmoncry
    waitmessage
    clearflag(FLAG_SUPPRESS_SPEAKER_NAME)
    delay(30)
    speakername("Kukui")
    msgbox("Rotom!
    
    Here, boy!
    I powered up your favorite Phone!
    
    Give {PLAYER} here a Helping Hand,
    yeah?")
    setflag(FLAG_SUPPRESS_SPEAKER_NAME)
    playmoncry(SPECIES_ROTOM, 0)
    applymovement(lab_rotom, moves(walk_in_place_down*2))
    waitmovement(0)
    msgbox("Kzzzt\.", MSGBOX_AUTOCLOSE)
    waitmoncry
    waitmessage
    clearflag(FLAG_SUPPRESS_SPEAKER_NAME)
    fadescreen(FADE_TO_WHITE)
    playse(SE_SWITCH)
    waitse
    playse(SE_SWITCH)
    waitse
    playse(SE_CLICK)
    waitse
    setobjectxy(lab_rotom, 15, 17)
    hideobjectat(lab_rotom, MAP_ALOLA_LABORATORY)
    setvar(VAR_ROTOM_PHONE_ENABLE, 2)
    fadescreen(FADE_FROM_WHITE)
    delay(30)
    rotommenudisplay("Uh, hey there! P-pleasure to meet you!\nI-I'm not nervouzzz or anything.")
    applymovement(lab_kukui, moves(face_down))
    waitmovement(0)
    speakername("Kukui")
    msgbox("Check it out, {PLAYER}!
    Now Rotom can talk right to you!
    
    It may take it a little while to get
    used to its new job, but I'd say
    Rotom's taken a liking to you!")
    applymovement(lab_lillie, moves(walk_in_place_up*2))
    waitmovement(0)
    speakername("Lillie")
    msgbox("And this will help how exactly?")
    applymovement(lab_kukui, moves(walk_in_place_down*2))
    waitmovement(0)
    speakername("Kukui")
    checkplayergender
    if (var(VAR_RESULT)==MALE)
    {
        msgbox("{PLAYER} hasn't been here in Alola
        too long yet.
        
        So I decided to give him this special
        Phone to help him navigate around.")
    }
    else
    {
        msgbox("{PLAYER} hasn't been here in Alola
        too long yet.
        
        So I decided to give her this special
        Phone to help her navigate around.")
    }
    dynmultichoice(20 ,8,TRUE, 5, 0, DYN_MULTICHOICE_CB_NONE, "Thank you!", "Hi, Rotom!")
    if (var(VAR_RESULT) == 0){
        applymovement(lab_kukui, moves(walk_in_place_down*2))
        waitmovement(0)
        speakername("Kukui")
        msgbox("You can ask Rotom for directions by
        opening the Rotom Phone and
        pressing {R_BUTTON}!
        
        You can also press the Rotom Reality
        feature to open the {COLOR RED}Town Map{COLOR DARK_GRAY}!")

    }
    else{
        applymovement(lab_kukui, moves(walk_in_place_down*2))
        waitmovement(0)
        speakername("Kukui")
        msgbox("You can see ask Rotom for directions
        by opening the Rotom Phone and
        pressing {R_BUTTON}!
        
        You can also press the Rotom Reality
        feature to open the {COLOR RED}Town Map{COLOR DARK_GRAY}!")
    }
    speakername("Kukui")
    msgbox("So, {PLAYER}, I'm leaving this Rotom
    Phone in your hands!
    
    Rotom, you look after {PLAYER}, yeah?
    
    All right then, {PLAYER}!
    Get a move on!")
    dynmultichoice(20 ,8,TRUE, 5, 0, DYN_MULTICHOICE_CB_NONE, "OK!", "What?")
    if (var(VAR_RESULT) == 0){
        applymovement(lab_kukui, moves(jump_in_place_down*2))
        playse(SE_LEDGE)
        waitse
        playse(SE_LEDGE)
        waitse
        waitmovement(0)
        speakername("Kukui")
        msgbox("To the Trainers' School!
        
        You've gotta learn the basics of being
        a Pok\emon Trainer through Pok\emon
        battling.
        
        It's a long road to becoming the island
        challenge champion, and the
        Trainers' School is the first step!")
    }
    else{
        applymovement(lab_kukui, moves(jump_in_place_down*2))
        playse(SE_LEDGE)
        waitse
        playse(SE_LEDGE)
        waitse
        waitmovement(0)
        speakername("Kukui")
        msgbox("To the Trainers' School!
        
        You've gotta learn the basics of being
        a Pok\emon Trainer through Pok\emon
        battling.
        
        It's a long road to becoming the island
        challenge champion, and the
        Trainers' School is the first step!")
    }
    applymovement(lab_lillie, moves(walk_in_place_up*2))
    waitmovement(0)
    bufferleadmonspeciesname(STR_VAR_1)
    speakername("Lillie")
    msgbox("So this is how the people of Alola
    connect with the world around them.
    
    And then there's the way that you and
    {STR_VAR_1} both chose one another.

    And now with Rotom helping you out as
    well\.
    
    Even Nebby likes you! I guess there's
    something about you that makes
    Pok\emon feel comfortable when
    they're by your side.")
    applymovement(lab_kukui, moves(walk_in_place_down*2))
    waitmovement(0)
    speakername("Kukui")
    checkplayergender
    if (var(VAR_RESULT)==MALE)
    {
        msgbox("Lillie!
        You take care of {PLAYER}, yeah?
        
        Until he gets used to Rotom,
        help him find his way around!")
    }
    else
    {
        msgbox("Lillie!
        You take care of {PLAYER}, yeah?
        
        Until she gets used to Rotom,
        help her find her way around!")
    }
    speakername("Lillie")
    msgbox("Of course, Professor Kukui!
    I'll wait outside.", MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(lab_lillie, moves(walk_down*3))
    waitmovement(0)
    playse(SE_EXIT)
    hideobjectat(lab_lillie, MAP_ALOLA_LABORATORY)
    waitse
    applymovement(lab_lillie, moves(walk_down))
    setobjectmovementtype(lab_rockruff, MOVEMENT_TYPE_LOOK_AROUND)
    setobjectmovementtype(lab_stufful, MOVEMENT_TYPE_LOOK_AROUND)
    setobjectmovementtype(lab_snubbull, MOVEMENT_TYPE_LOOK_AROUND)
    endcutscene
    release
    end
}

script AlolaLaboratory_FirstTimeIntroSkip{
    lock
    closemessage
    fadescreen(FADE_TO_BLACK)
    hideobjectat(lab_lillie, MAP_ALOLA_LABORATORY)
    setobjectxy(lab_lillie, 14, 17)
    hideobjectat(lab_rotom, MAP_ALOLA_LABORATORY)
    setobjectxy(lab_rotom, 15, 17)
    setobjectxy(LOCALID_PLAYER, 15, 13)
    setvar(VAR_IKITOWN_STATE, 19)
    applymovement(lab_rockruff, moves(face_right))
    waitmovement(0)
    special(StopAllObjectMovements)
    special(CloseScriptMenus)
    // special(SnapCameraToPlayer)
    // special(RemoveCameraObject)
    setvar(VAR_ROTOM_PHONE_ENABLE, 2)
    fadescreen(FADE_FROM_BLACK)
    release
    end
}