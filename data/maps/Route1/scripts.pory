mapscripts Route1_MapScripts{
    MAP_SCRIPT_ON_TRANSITION{
        call_if_unset(FLAG_IKITOWN_FESTIVAL_COMPLETE, Route1CloseGates)
        if(flag(FLAG_IKITOWN_FESTIVAL_COMPLETE))
        {
            call_if_unset(FLAG_OPEN_TRAINER_SCHOOL, Route1CloseGates2)
        }
        setrespawn(HEAL_LOCATION_PLAYER_HOUSE)
        end
        }
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE[FLAG_LILLIE_INTRO_PLAYED, FALSE {hideobjectat(LOCALID_PLAYER, MAP_ROUTE1)}
    VAR_IKITOWN_STATE, 10 {setflag(FLAG_HIDE_MAP_NAME_POPUP)}
    VAR_IKITOWN_STATE, 17 {setflag(FLAG_HIDE_MAP_NAME_POPUP)}]
    MAP_SCRIPT_ON_FRAME_TABLE[FLAG_LILLIE_INTRO_PLAYED, FALSE: LittleGirlChasesMeowthIntro
    VAR_IKITOWN_STATE, 10 {call(Route1_KukuiCatchingTutorial)}
    VAR_IKITOWN_STATE, 17: Route1_LillieWalkToLab]
}

script Route1_LillieWalkToLab{
    lock
    playse(SE_PIN)
    hideobjectat(route1_mom, MAP_ROUTE1)
    applymovement(route1_lillie, moves(emote_exclamation_mark, face_up))
    waitmovement(route1_lillie)
    clearflag(FLAG_HIDE_MAP_NAME_POPUP)
    delay(30)
    startcutscene(CUTSCENE_ROUTE1_LILLIE_WALK_TO_LAB)
    applymovement(LOCALID_PLAYER, moves(walk_down*3, face_left))
    applymovement(route1_lillie, moves(delay_16*3, face_right))
    applymovement(route1_mom, moves(walk_down*2))
    waitmovement(0)
    delay(15)
    speakername("Lillie")
    msgbox("Oh, Um\.
    
    The professor said\.")
    applymovement(route1_lillie, moves(face_down))
    waitmovement(route1_lillie)
    msgbox("\qoHey there, Lillie!
    Bring me that great new Trainer. Woo!\qc")
    applymovement(route1_lillie, moves(face_right))
    waitmovement(route1_lillie)
    msgbox("So I'm here to show you the way to his
    Pokémon Lab, if you'll come with me!
    
    It's, um\. It's this way.", MSGBOX_AUTOCLOSE)
    opendoor(16, 20)
    waitdooranim()
    showobjectat(route1_mom, MAP_ROUTE1)
    applymovement(route1_mom, moves(walk_down))
    waitmovement(route1_mom)
    closedoor(16, 20)
    waitdooranim()
    applymovement(route1_lillie, moves(face_up))
    applymovement(LOCALID_PLAYER, moves(face_up))
    waitmovement(0)
    speakername("Mom")
    msgbox("{PLAYER}!", MSGBOX_AUTOCLOSE)
    applymovement(route1_mom, moves(walk_down*2))
    waitmovement(route1_mom)
    msgbox("Here. A little pocket money for you.
    Don't go wasting it on anything silly!")
    addmoney(1000)
    delay(30)
    applymovement(route1_mom, moves(walk_left, face_down))
    waitmovement(route1_mom)
    msgbox("Oh! Well done, {PLAYER}.
    You're already making friends?
    And what a cute friend you've found!
    
    I knew Alola would be a great place for
    us. We keep meeting wonderful people!")
    applymovement(route1_lillie, moves(walk_in_place_up*2))
    waitmovement(route1_lillie)
    speakername("Lillie")
    msgbox("M-me? Well, thank you\.
    
    My name is Lillie.
    It's very nice to meet you.", MSGBOX_AUTOCLOSE)
    applymovement(route1_mom, moves(walk_right, face_down))
    waitmovement(route1_mom)
    bufferleadmonspeciesname(STR_VAR_1)
    speakername("Mom")
    msgbox("Looks like its finally your time to
    shine, sweetie!
    
    Enjoy yourself out there with
    {STR_VAR_1}.
    And don't be gone too long!", MSGBOX_AUTOCLOSE)
    applymovement(route1_mom, moves(walk_up*2))
    waitmovement(route1_mom)
    opendoor(16, 20)
    waitdooranim()
    applymovement(route1_mom, moves(walk_up))
    waitmovement(route1_mom)
    hideobjectat(route1_mom, MAP_ROUTE1)
    closedoor(16, 20)
    waitdooranim()
    applymovement(route1_mom, moves(walk_up*2))
    waitmovement(route1_mom)
    delay(30)
    applymovement(route1_lillie, moves(face_right))
    applymovement(LOCALID_PLAYER, moves(face_left))
    waitmovement(0)
    speakername("Lillie")
    msgbox("You\.have a very nice mother, don't you?
    
    We should get going.

    It's just south to the Pokémon
    Research Lab.", MSGBOX_AUTOCLOSE)
    applymovement(route1_lillie, moves(walk_left*6, walk_down*9))
    waitmovement(route1_lillie)
    removeobject(route1_lillie)
    setflag(FLAG_HIDE_ROUTE1_LILLIE)
    waitmovement(0)
    setvar(VAR_IKITOWN_STATE, 18)
    endcutscene
    release
    end
}

script Lillie_WalktoLabSkip{
    lock
    closemessage
    fadescreenswapbuffers(FADE_TO_BLACK)
    setobjectxy(LOCALID_PLAYER, 16, 24)
    applymovement(LOCALID_PLAYER, moves(face_down))
    waitmovement(LOCALID_PLAYER)
    setobjectxy(route1_mom, 16, 18)
    removeobject(route1_lillie)
    setflag(FLAG_HIDE_ROUTE1_LILLIE)
    special(StopAllObjectMovements)
    special(CloseScriptMenus)
    special(SnapCameraToPlayer)
    special(RemoveCameraObject)
    setobjectxy(route1_mom, 16, 18)
    setobjectxy(HauoliOutskirtsLittleBoy, 14, 31)
    setvar(VAR_IKITOWN_STATE, 18)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    release
    end
}

script Route1_AlolanMeowthNPC{
    lock
    faceplayer
    playmoncry(SPECIES_MEOWTH_ALOLA, 0)
    msgbox("Hsss!")
    release
    end
}

script Route1_LittleGirlPressB{
    lock
    faceplayer
    msgbox("You can go with me!
    If you can dash with {B_BUTTON}!
    
    What do you think of my song?")
    release
    
}

script Route1_Trigger_BlockRightPath{
    lock
    applymovement(route1blockingboy, moves(face_down))
    waitmovement(route1blockingboy)
    msgbox("Watch it, cuz!
    
    It's dangerous to get too close to
    a Pokémon while it's using one of
    its moves!")
    applymovement(route1blockingrockruff, moves(face_down))
    waitmovement(route1blockingrockruff)
    playmoncry(SPECIES_ROCKRUFF, 0)
    applymovement(route1blockingrockruff, moves(walk_in_place_down*2))
    waitmovement(route1blockingrockruff)
    msgbox("Ruff!", MSGBOX_AUTOCLOSE)
    applymovement(LOCALID_PLAYER, moves(walk_down))
    waitmovement(LOCALID_PLAYER)
    applymovement(route1blockingboy, moves(face_up))
    waitmovement(route1blockingboy)
    applymovement(route1blockingrockruff, moves(face_up))
    waitmovement(route1blockingrockruff)
    release
    end
}

script Route1CloseGates{
    setmaplayoutindex(LAYOUT_ROUTE1_closed)
    return
}

script Route1CloseGates2{
    setmaplayoutindex(LAYOUT_ROUTE1_leftclosed)
    return
}

script LittleGirlChasesMeowthIntro{
    lock
    special(SpawnCameraObject)
    playmoncry(SPECIES_MEOWTH_ALOLA, 0)
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_fast_down*5))
    applymovement(chasedmeowth, moves(walk_fast_down*5))
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_fast_left*11))
    applymovement(chasedmeowth, moves(walk_fast_left*20))
    waitmovement(0)
    playmoncry(SPECIES_MEOWTH_ALOLA, 0)
    delay(60)
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_slow_up*2))
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_slow_diag_northeast*3))
    waitmovement(0)
    gettimeofday
    if((var(VAR_0x8000) == TIME_NIGHT) || (var(VAR_0x8000) == TIME_EVENING)){
        speakername("Mom")
        msgbox("Ahhh! Could anything be more soothing?
        The first evening spent under
        Alola's calm moon!
        
        I feel like I could stay out here all
        night!")
    }
    else{
        speakername("Mom")
        msgbox("Ahhh! Can't you just feel that warmth?
        The first day spent under Alola's
        sun!
        
        It's so warm and bright here!")
    }
    msgbox("But that's enough of that!
    Time to unpack all these boxes!")
    applymovement(momintro, moves(face_up))
    waitmovement(0)
    msgbox("Meowth?
    Go get {PLAYER} for me, would you?")
    setflag(FLAG_SUPPRESS_SPEAKER_NAME)
    waitmessage
    playmoncry(SPECIES_MEOWTH, 0)
    msgbox("Meow?")
    clearflag(FLAG_SUPPRESS_SPEAKER_NAME)
    setflag(FLAG_HIDE_IKITOWN_FESTIVALNPCS)
    setflag(FLAG_HIDE_IKITOWN_FESTIVALNPCS2)
    setflag(FLAG_HIDE_IKITOWN_FESTIVALNPCS3)
    setflag(FLAG_HIDE_INTRO_UR)
    warp(MAP_PLAYER_ROOM, 12, 10)
    waitstate
    release
    end
}

script Route1_KukuiCatchingTutorial{
    lock
    playse(SE_PIN)
    special(SpawnCameraObject)
    applymovement(catchingintrokukui, moves(emote_exclamation_mark))
    applymovement(OBJ_EVENT_ID_CAMERA, moves(delay_16*3, walk_down*3))
    waitmovement(0)
    clearflag(FLAG_HIDE_MAP_NAME_POPUP)
    speakername("Kukui")
    msgbox("Hey there, {PLAYER}!
    It's about time we set out for the
    festival, yeah!
    
    But first\.
    I've got something to teach you,
    yeah, now that you're a real
    Pokémon Trainer.
    
    It's the most basic of all the basics.
    Come on-to Route 1!", MSGBOX_AUTOCLOSE)
    applymovement(catchingintrokukui, moves(walk_down, walk_right*6, face_left))
    waitmovement(catchingintrokukui)
    speakername("Kukui")
    msgbox("{PLAYER}!
    Hurry it up, cousin!

    Pretend you're a Pokémon and use your
    Agility!", MSGBOX_AUTOCLOSE)
    applymovement(catchingintrokukui, moves(walk_right*5))
    waitmovement(catchingintrokukui)
    removeobject(catchingintrokukui)
    delay(30)
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_up*3))
    waitmovement(0)
    special(RemoveCameraObject)
    setvar(VAR_IKITOWN_STATE, 11)
    setflag(FLAG_KUKUI_CATCHING_TUTORIAL1)
    clearflag(FLAG_KUKUI_CATCHING_TUTORIAL2)
    clearflag(FLAG_HIDE_IKITOWN_FESTIVALNPCS)
    clearflag(FLAG_HIDE_IKITOWN_FESTIVALNPCS2)
    setflag(FLAG_HIDE_IKITOWN_REGULARNPCS)
    clearflag(FLAG_HIDE_INTRO_UR)
    release
    end
}

script Route1_trigger_kukui_catching_tutorial{
    lock
    speakername("Kukui")
    msgbox("{PLAYER}!
    Hurry it up, cousin!

    Pretend you're a Pokémon and use your
    Agility!")
    applymovement(LOCALID_PLAYER, moves(walk_right))
    release
    end
}

script MomSaysHi{
    lock
    faceplayer
    speakername("Mom")
    msgbox(format("How are you doing, honey?\nYou look a little tired.\pYou should take a rest."))
    fadescreenswapbuffers(FADE_TO_BLACK)
    playfanfare(MUS_HEAL)
    waitfanfare
    special(HealPlayerParty)
    setflag(FLAG_DN_FLAG_DEXNAV_GET)
    setflag(FLAG_ENABLE_STAT_EDITOR)
    setflag(FLAG_PORTABLE_PC_TOGGLE)
    setflag(FLAG_RECEIVED_SUPER_ROD)
    setflag(FLAG_EGG_MOVES)
    setflag(FLAG_TUTOR_MOVES)
    if(flag(FLAG_SHINY_RIDE))
    {
        clearflag(FLAG_SHINY_RIDE)
        clearflag(FLAG_SHINY_SURF)
    }
    else{
        setflag(FLAG_SHINY_RIDE)
        setflag(FLAG_SHINY_SURF)
    }
    if(var(VAR_ROTOM_PHONE_ENABLE)<1)
    {
        setvar(VAR_ROTOM_PHONE_ENABLE, 1)
    }
    else{
        setvar(VAR_ROTOM_PHONE_ENABLE, 0)
    }
    release
    fadescreenswapbuffers(FADE_FROM_BLACK)
    msgbox("Take care, honey!")
    release
end
}

script Mailbox{
    lock
    msgbox("{PLAYER}'s House")
    release
    end
}

script HauoliOutskirts_Battle_VsYoungsterKevin{
    trainerbattle_single(TRAINER_YOUNGSTER_KEVIN, "Let's go!\nKneecaps!", "Aww\.\nBrought to my knees.")
    msgbox("I gotta catch more Pokémon!\nPokémon with cool knees are so neat.", MSGBOX_AUTOCLOSE)
    release
    end
}

