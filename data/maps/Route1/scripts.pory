msgbox("I gotta catch more Pokémon!\nPokémon with cool knees are so neat.", MSGBOX_NPC)
end    
}

script testscript{
    msgbox("okay this is a test.
    It seems this is a suitable line lengthc
    for scripting. This is working well.
    
    Do I need to do anything to compile
    this?
    
    
    10-4, good buddy! I'll let everybody out
    here know you're on your way!
    
    Yeah, that's a name that hits you like a
    Trop Kick right to the head! Woo!
    
    Can't wait to see you here in person then,
    cousin!", MSGBOX_NPC)
    end
}

script Route1_Trigger_HeadEastToIkiTown{
    lock
    msgbox("The Iki Town Festival awaits!
    Head east, cousin!", MSGBOX_AUTOCLOSE)
    applymovement(LOCALID_PLAYER, moves(walk_right))
    waitmovement(LOCALID_PLAYER)
    release
    end
}