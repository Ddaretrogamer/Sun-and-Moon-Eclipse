mapscripts Route1NN_MapScripts{

}

script YungoosMeowth_Blocking{
    lock
    msgbox("We can win this! We can win this!
    Just a bit more!", MSGBOX_AUTOCLOSE)
    playmoncry(SPECIES_YUNGOOS, 0)
    applymovement(route1yungoos2, moves(walk_in_place_down*2))
    waitmovement(route1yungoos2)
    msgbox("Meowth, use Scratch!", MSGBOX_AUTOCLOSE)
    playmoncry(SPECIES_MEOWTH, 0)
    applymovement(route1meowth2, moves(walk_in_place_up*2))
    waitmovement(route1meowth2)
    playse(SE_M_SCRATCH)
    waitse
    release
    end

}

script PowerOfScience{
    lock
    faceplayer
    msgbox("The power of science is amazing!
    
    You can enjoy a festival with people
    from around the world without taking
    a step!
    
    Every day is a festival when you can
    do that!")
    release
    end
}

script Route1NN_KukuiGoToIki{
    lock
    faceplayer
    speakername("Kukui")
    msgbox("Iki Town is just up ahead, yeah.")
    release
    end
}

script Route1NN_Trigger_MiddleGetStarters{
    lock
    applymovement(LOCALID_PLAYER, moves(walk_up, face_left))
    waitmovement(LOCALID_PLAYER)
    call(Route1NN_Trigger_GetStarters)
}

script Route1NN_Trigger_BottomGetStarters{
    lock
    applymovement(LOCALID_PLAYER, moves(walk_up*2, face_left))
    waitmovement(LOCALID_PLAYER)
    call(Route1NN_Trigger_GetStarters)
}

script Route1NN_Trigger_TopGetStarters{
    lock
    applymovement(LOCALID_PLAYER, moves(walk_down, face_left))
    waitmovement(LOCALID_PLAYER)
    call(Route1NN_Trigger_GetStarters)
}

script Route1NN_Trigger_GetStarters{
    lock
    setflag(FLAG_HIDE_IKITOWN_INTRO)
    clearflag(FLAG_SUPPRESS_SPEAKER_NAME)
    setflag(FLAG_SYS_POKEMON_GET)
    special(SpawnCameraObject)
    callnative(Script_RollShiny)
    copyvar(VAR_TEMP_1, VAR_RESULT)
    callnative(Script_RollShiny)
    copyvar(VAR_TEMP_2, VAR_RESULT)
    callnative(Script_RollShiny)
    copyvar(VAR_TEMP_3, VAR_RESULT)
    playse(SE_M_SCRATCH)
    waitse
    addobject(rt1_yungoos)
    playse(SE_PIN)
    applymovement(LOCALID_PLAYER, moves(emote_exclamation_mark))
    waitmovement(LOCALID_PLAYER)
    applymovement(rt1_yungoos, moves(walk_right*2))
    waitmovement(rt1_yungoos)
    delay(30)
    playmoncry(SPECIES_YUNGOOS, 0)
    msgbox("Yaaahhhh!", MSGBOX_AUTOCLOSE)
    waitmessage 
    applymovement(rt1_yungoos, moves(walk_right))
    waitmovement(rt1_yungoos)
    fadescreenswapbuffers(FADE_TO_BLACK)
    addobject(kukuistarters)
    applymovement(kukuistarters, moves(walk_faster_down*7, walk_faster_right*6))
    if (var(VAR_TEMP_1) == SHINY_MODE_ALWAYS){
        addobject(rowletshiny)
        applymovement(rowletshiny, moves(walk_faster_down*4, walk_faster_left*5))
    }
    else{
        addobject(rowlet)
        applymovement(rowlet, moves(walk_faster_down*4, walk_faster_left*5))
    }
    if (var(VAR_TEMP_2) == SHINY_MODE_ALWAYS){
        addobject(littenshiny)
        applymovement(littenshiny, moves(walk_faster_down*5, walk_faster_left*6))
    }
    else{
        addobject(litten)
        applymovement(litten, moves(walk_faster_down*5, walk_faster_left*6))
    }
    if (var(VAR_TEMP_3) == SHINY_MODE_ALWAYS){
        addobject(popplioshiny)
        applymovement(popplioshiny, moves(walk_faster_down*6, walk_faster_left*7))
    }
    else{
        addobject(popplio)
        applymovement(popplio, moves(walk_faster_down*6, walk_faster_left*7))
    }
    waitmovement(0)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    if (var(VAR_TEMP_1) == SHINY_MODE_ALWAYS){
        playmoncry(SPECIES_ROWLET, 0)
        applymovement(rowletshiny, moves(emote_exclamation_mark,walk_in_place_left*2))
        waitmovement(rowletshiny)
        msgbox("Hoooo!", MSGBOX_AUTOCLOSE)
    }
    else{
        playmoncry(SPECIES_ROWLET, 0)
        applymovement(rowlet, moves(emote_exclamation_mark, walk_in_place_left*2))
        waitmovement(rowlet)
        msgbox("Hoooo!", MSGBOX_AUTOCLOSE)
    }
    if (var(VAR_TEMP_2) == SHINY_MODE_ALWAYS){
        playmoncry(SPECIES_LITTEN, 0)
        applymovement(littenshiny, moves(emote_exclamation_mark, walk_in_place_left*2))
        waitmovement(littenshiny)
        msgbox("Mrrr!", MSGBOX_AUTOCLOSE)
    }
    else{
        playmoncry(SPECIES_LITTEN, 0)
        applymovement(litten, moves(emote_exclamation_mark, walk_in_place_left*2))
        waitmovement(litten)
        msgbox("Mraaarrrr!", MSGBOX_AUTOCLOSE)
    }
    if (var(VAR_TEMP_3) == SHINY_MODE_ALWAYS){
        playmoncry(SPECIES_POPPLIO, 0)
        applymovement(popplioshiny, moves(emote_exclamation_mark, walk_in_place_left*2))
        waitmovement(popplioshiny)
        msgbox("Prrr!", MSGBOX_AUTOCLOSE)
    }
    else{
        playmoncry(SPECIES_POPPLIO, 0)
        applymovement(popplio, moves(emote_exclamation_mark, walk_in_place_left*2))
        waitmovement(popplio)
        msgbox("Bwark! Bwark!", MSGBOX_AUTOCLOSE)
    }
    playmoncry(SPECIES_YUNGOOS, 0)
    applymovement(rt1_yungoos, moves(emote_exclamation_mark, walk_in_place_right*2))
    waitmovement(rt1_yungoos)
    msgbox("Ya…yah…", MSGBOX_AUTOCLOSE)
    playse(SE_FLEE)
    applymovement(rt1_yungoos, moves(walk_fast_left*7))
    waitmovement(rt1_yungoos)
    delay(60)
    if (var(VAR_TEMP_1) == SHINY_MODE_ALWAYS){
        applymovement(rowletshiny, moves(face_right))
    }
    else{
        applymovement(rowlet, moves(face_right))
    }
    if (var(VAR_TEMP_2) == SHINY_MODE_ALWAYS){
        applymovement(littenshiny, moves(face_right))
    }
    else{
        applymovement(litten, moves(face_right))
    }
    if (var(VAR_TEMP_3) == SHINY_MODE_ALWAYS){
        applymovement(popplioshiny, moves(face_right))
    }
    else{
        applymovement(popplio, moves(face_right))
    }
    waitmovement(0)
    speakername("Kukui")
    applymovement(kukuistarters, moves(walk_up*6, face_left, delay_16))
    waitmovement(kukuistarters)
    playse(SE_PIN)
    applymovement(LOCALID_PLAYER, moves(emote_exclamation_mark, face_right))
    waitmovement(0)
    speakername("Kukui")
    delay(60)
    applymovement(kukuistarters, moves(walk_in_place_left*2))
    waitmovement(kukuistarters)
    msgbox("Hey there, cousin!", MSGBOX_AUTOCLOSE)
    applymovement(LOCALID_PLAYER, moves(walk_right*3))
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_right*3))
    waitmovement(0)
    if (var(VAR_TEMP_1) == SHINY_MODE_ALWAYS){
        applymovement(rowletshiny, moves(walk_right*3))
    }
    else{
        applymovement(rowlet, moves(walk_right*3))
    }
    if (var(VAR_TEMP_2) == SHINY_MODE_ALWAYS){
        applymovement(littenshiny, moves(walk_right*3))
    }
    else{
        applymovement(litten, moves(walk_right*3))
    }
    if (var(VAR_TEMP_3) == SHINY_MODE_ALWAYS){
        applymovement(popplioshiny, moves(walk_right*3))
    }
    else{
        applymovement(popplio, moves(walk_right*3))
    }
    waitmovement(0)
    speakername("Kukui")
    msgbox("Hang on, I know you\.
    You're {PLAYER}, right?

    You OK?
    
    I saw you get attacked like that!")
    dynmultichoice(11 ,8,TRUE, 5, 0, DYN_MULTICHOICE_CB_NONE, "Yeah, I got a bit of help", "I was scared spitless!")
    if(var(VAR_RESULT) == 0)
    {
        applymovement(LOCALID_PLAYER, moves(walk_in_place_right*2))
        waitmovement(LOCALID_PLAYER)
        speakername("Kukui")
        msgbox("Looks like you did!

        Though I sure didn't expect that,
        yeah…
        
        I didn't think these little fellows
        would dash out on their own to help
        save a stranger!")
    }
    else
    {
        applymovement(LOCALID_PLAYER, moves(walk_in_place_right*2))
        waitmovement(LOCALID_PLAYER)
        speakername("Kukui")
        msgbox("You and me both, cousin!
        
        I'm looking after these Pokémon,
        but they dashed right out on
        their own to save you!")
    }
    speakername("Kukui")
    msgbox("But I guess I'm getting ahead of
    myself.
    
    Welcome to Alola, the Pokémon paradise!")

    applymovement(kukuistarters, moves(jump_in_place_left*2))
    playse(SE_LEDGE)
    waitse
    playse(SE_LEDGE)
    waitse
    waitmovement(kukuistarters)

    msgbox("That's what I'm supposed to be
    saying.

    I'm Kukui, yeah. the Pokémon
    Professor.
    
    People and Pokémon live and work
    together here in Alola, too.
    
    Don't you ever forget…
    
    You can go anywhere, yeah, as long
    as you got Pokémon in your corner!")
    applymovement(kukuistarters, moves(jump_in_place_left*2))
    playse(SE_LEDGE)
    waitse
    playse(SE_LEDGE)
    waitse
    waitmovement(kukuistarters)
    msgbox("Wild Pokémon could be lurking in
    the tall grass, yeah, just waiting
    to leap out and bite you, but
    you'll be fine if you've got a
    partner of your own!
    
    Hey there!
    
    Here, let me introduce the Pokémon
    that helped you just now.", MSGBOX_AUTOCLOSE)
    fadescreenswapbuffers(FADE_TO_BLACK)
    setflag(FLAG_TEMP_2)
    removeobject(techguy)
    applymovement(LOCALID_PLAYER, moves(walk_faster_right*2, walk_faster_up*2, face_up))
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_faster_right*2, walk_faster_up*2))
    waitmovement(0)
    applymovement(kukuistarters, moves(walk_faster_right*1, walk_faster_up*2))
    applymovement(kukuistarters, moves(face_up))
    waitmovement(kukuistarters)
    removeobject(rowlet)
    removeobject(litten)
    removeobject(popplio)
    removeobject(rowletshiny)
    removeobject(littenshiny)
    removeobject(popplioshiny)
    if (var(VAR_TEMP_1) == SHINY_MODE_ALWAYS){
        addobject(rowletshiny2)
        setobjectxy(rowletshiny2, 26, 16)
    }
    else{
        addobject(rowlet2)        
        setobjectxy(rowlet2, 26, 16)
    }
    if (var(VAR_TEMP_2) == SHINY_MODE_ALWAYS){
        addobject(littenshiny2)
        setobjectxy(littenshiny2, 27, 16)
    }
    else{
        addobject(litten2)
        setobjectxy(litten2, 27, 16)
    }
    if (var(VAR_TEMP_3) == SHINY_MODE_ALWAYS){
        addobject(popplioshiny2)    
        setobjectxy(popplioshiny2, 28, 16)
    }
    else{
        addobject(popplio2)
        setobjectxy(popplio2, 28, 16)
    }
    fadescreenswapbuffers(FADE_FROM_BLACK)
    delay(60)
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_slow_up, walk_slow_diag_northwest))
    waitmovement(0)
    msgbox("This is the Grass-type Pokémon, Rowlet.")
    if (var(VAR_TEMP_1) == SHINY_MODE_ALWAYS){
        playmoncry(SPECIES_ROWLET, 0)
        setflag(FLAG_SUPPRESS_SPEAKER_NAME)
        msgbox("Hoo!", MSGBOX_AUTOCLOSE)
        closemessage
        applymovement(rowletshiny2, moves(face_left, delay_16, face_up, delay_16, face_right, delay_16, face_down, walk_in_place_down*2))
        waitmovement(rowletshiny2)
        clearflag(FLAG_SUPPRESS_SPEAKER_NAME)
        delay(30)
    }
    else{
        playmoncry(SPECIES_ROWLET, 0)
        setflag(FLAG_SUPPRESS_SPEAKER_NAME)
        msgbox("Hoo!", MSGBOX_AUTOCLOSE)
        closemessage
        applymovement(rowlet2, moves(face_left, delay_16, face_up, delay_16, face_right, delay_16, face_down, walk_in_place_down*2))
        waitmovement(rowlet2)
        clearflag(FLAG_SUPPRESS_SPEAKER_NAME)
        delay(30)
    }
    speakername("Kukui")
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_right))
    waitmovement(0)
    msgbox("And the Fire-type Pokémon, Litten.")
    if (var(VAR_TEMP_2) == SHINY_MODE_ALWAYS){
            playmoncry(SPECIES_LITTEN, 0)
            setflag(FLAG_SUPPRESS_SPEAKER_NAME)
            msgbox("Mrawr.", MSGBOX_AUTOCLOSE)
            closemessage
            applymovement(littenshiny2, moves(jump_in_place_down))
            playse(SE_LEDGE)
            waitmovement(littenshiny2)
            clearflag(FLAG_SUPPRESS_SPEAKER_NAME)
            delay(30)
        }
        else{
            playmoncry(SPECIES_LITTEN, 0)
            setflag(FLAG_SUPPRESS_SPEAKER_NAME)
            msgbox("Mrawr.", MSGBOX_AUTOCLOSE)
            closemessage
            applymovement(litten2, moves(jump_in_place_down))
            playse(SE_LEDGE)
            waitmovement(litten2)
            clearflag(FLAG_SUPPRESS_SPEAKER_NAME)
            delay(30)
        }
    speakername("Kukui")
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_right))
    waitmovement(0)
    msgbox("And the Water-type Pokémon Popplio.")
    if (var(VAR_TEMP_3) == SHINY_MODE_ALWAYS){
            playmoncry(SPECIES_POPPLIO, 0)
            setflag(FLAG_SUPPRESS_SPEAKER_NAME)
            msgbox("Bwark?", MSGBOX_AUTOCLOSE)
            closemessage
            applymovement(popplioshiny2, moves(face_up, delay_16, walk_in_place_up*2, delay_16*2, face_down))
            playse(SE_M_CRABHAMMER)
            waitse
            playse(SE_M_CRABHAMMER)
            waitse
            waitmovement(popplioshiny2)
            clearflag(FLAG_SUPPRESS_SPEAKER_NAME)
            delay(30)
        }
        else{
            playmoncry(SPECIES_POPPLIO, 0)
            setflag(FLAG_SUPPRESS_SPEAKER_NAME)
            msgbox("Bwark?", MSGBOX_AUTOCLOSE)
            closemessage
            applymovement(popplio2, moves(face_up, delay_16, walk_in_place_up*2, delay_16*2, face_down))
            playse(SE_M_CRABHAMMER)
            waitse
            playse(SE_M_CRABHAMMER)
            waitse
            waitmovement(popplio2)
            clearflag(FLAG_SUPPRESS_SPEAKER_NAME)
            delay(30)
        }
    speakername("Kukui")
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_slow_diag_southwest, walk_slow_down))
    waitmovement(0)
    msgbox("Y'see, the fact of the matter is…

    one of these Pokémon will become
    your first partner, woo!
    
    Heh…

    Maybe that's why they wanted to save
    you?
    
    Go on and choose the one you'd like
    to keep as your partner, cousin!")
    dynmultichoice(22,6,TRUE, 5, 0, DYN_MULTICHOICE_CB_NONE, "{COLOR GREEN}Rowlet", "{COLOR RED}Litten", "{COLOR BLUE}Popplio")
    switch(var(VAR_RESULT)){
    case 0:
        speakername("Kukui")
        msgbox("Rowlet can fly up on its enemies real
        quiet like and catch 'em by surprise!
        
        So, you wanna go with the Grass-type
        Pokémon Rowlet?", MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES){
            if (var(VAR_TEMP_3) == SHINY_MODE_ALWAYS){
                setflag(FLAG_RIVAL_SHINY)
            }
            if (var(VAR_TEMP_2) == SHINY_MODE_ALWAYS){
                setflag(FLAG_KUKUI_SHINY)
            }
            if (var(VAR_TEMP_1) == SHINY_MODE_ALWAYS){
                givemon(SPECIES_ROWLET, 5, shinyMode=SHINY_MODE_ALWAYS)
                applymovement(rowletshiny2, moves(walk_down, walk_right, face_down))
                waitmovement(rowletshiny2)
                playmoncry(SPECIES_ROWLET, 0)
                applymovement(rowletshiny2, moves(face_left, delay_16, face_up, delay_16, face_right, delay_16, face_down))
                waitmovement(rowletshiny2)
                delay(30)
                playse(SE_PIN)
                applymovement(rowletshiny2, moves(emote_heart))
                waitmovement(rowletshiny2)
                delay(60)
            }
            else{
                givemon(SPECIES_ROWLET, 5, shinyMode=SHINY_MODE_NEVER)
                applymovement(rowlet2, moves(walk_down, walk_right, face_down))
                waitmovement(rowlet2)
                playmoncry(SPECIES_ROWLET, 0)
                applymovement(rowlet2, moves(face_left, delay_16, face_up, delay_16, face_right, delay_16, face_down))
                waitmovement(rowlet2)
                delay(30)
                playse(SE_PIN)
                applymovement(rowlet2, moves(emote_heart))
                waitmovement(rowlet2)
                delay(60)
            }
            setvar(VAR_STARTER_MON, 0)
            break
        }
        else{
            speakername("Kukui")
            msgbox("I know the feeling, cousin\.
            I had a real hard time choosing once,
            too.")
            call(Route1NN_BackOutOfStarter)
        }
    case 1: 
        speakername("Kukui")
        msgbox("Litten may use Fire-type moves, but
        it's one cool cat!
        
        So, you wanna go with the Fire-type
        Pokémon Litten?", MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES){
            if (var(VAR_TEMP_3) == SHINY_MODE_ALWAYS){
                setflag(FLAG_KUKUI_SHINY)
            }
            if (var(VAR_TEMP_1) == SHINY_MODE_ALWAYS){
                setflag(FLAG_RIVAL_SHINY)
            }
            if (var(VAR_TEMP_2) == SHINY_MODE_ALWAYS){
                givemon(SPECIES_LITTEN, 5, shinyMode=SHINY_MODE_ALWAYS)
                applymovement(littenshiny2, moves(walk_down))
                waitmovement(littenshiny2)
                playmoncry(SPECIES_LITTEN, 0)
                waitse
                playse(SE_LEDGE)
                applymovement(littenshiny2, moves(jump_in_place_down))
                waitmovement(littenshiny2)
                delay(30)
                playse(SE_PIN)
                applymovement(littenshiny2, moves(emote_heart))
                waitmovement(littenshiny2)
                delay(60)
            }
            else{
                givemon(SPECIES_LITTEN, 5, shinyMode=SHINY_MODE_NEVER)
                applymovement(litten2, moves(walk_down))
                waitmovement(litten2)
                playmoncry(SPECIES_LITTEN, 0)
                waitse
                playse(SE_LEDGE)
                applymovement(litten2, moves(jump_in_place_down))
                waitmovement(litten2)
                delay(30)
                playse(SE_PIN)
                applymovement(litten2, moves(emote_heart))
                waitmovement(litten2)
                delay(60)
            }
            setvar(VAR_STARTER_MON, 1)
            break
        }
        else{
            speakername("Kukui")
            msgbox("I know the feeling, cousin\.
            I had a real hard time choosing once,
            too.")
            call(Route1NN_BackOutOfStarter)
        }
    case 2: 
        speakername("Kukui")
        msgbox("Popplio works hard and makes some
        pretty awesome balloons!
        
        So, you wanna go with the Water-type
        Pokémon Popplio?", MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES){
            if (var(VAR_TEMP_2) == SHINY_MODE_ALWAYS){
                setflag(FLAG_RIVAL_SHINY)
            }
            if (var(VAR_TEMP_1) == SHINY_MODE_ALWAYS){
                setflag(FLAG_KUKUI_SHINY)
            }
            if (var(VAR_TEMP_3) == SHINY_MODE_ALWAYS){
                givemon(SPECIES_POPPLIO, 5, shinyMode=SHINY_MODE_ALWAYS)
                applymovement(popplioshiny2, moves(walk_down, walk_left, face_down))
                waitmovement(popplioshiny2)
                playmoncry(SPECIES_POPPLIO, 0)
                waitse
                playse(SE_LEDGE)
                applymovement(popplioshiny2, moves(jump_in_place_down))
                waitmovement(popplioshiny2)
                delay(30)
                playse(SE_PIN)
                applymovement(popplioshiny2, moves(emote_heart))
                waitmovement(popplioshiny2)
                delay(60)
            }
            else{
                givemon(SPECIES_POPPLIO, 5, shinyMode=SHINY_MODE_NEVER)
                applymovement(popplio2, moves(walk_down, walk_left, face_down))
                waitmovement(popplio2)
                playmoncry(SPECIES_POPPLIO, 0)
                waitse
                playse(SE_LEDGE)
                applymovement(popplio2, moves(jump_in_place_down))
                waitmovement(popplio2)
                delay(30)
                playse(SE_PIN)
                applymovement(popplio2, moves(emote_heart))
                waitmovement(popplio2)
                delay(60)
            }
            setvar(VAR_STARTER_MON, 2)
            break
        }
        else{
            speakername("Kukui")
            msgbox("I know the feeling, cousin\.
            I had a real hard time choosing once,
            too.")
            call(Route1NN_BackOutOfStarter)
        }
    }
    bufferleadmonspeciesname(STR_VAR_1)
    applymovement(kukuistarters, moves(face_left))
    applymovement(LOCALID_PLAYER, moves(face_right))
    waitmovement(0)
    msgbox("Would you like to nickname your
    {STR_VAR_1}?", MSGBOX_YESNO)
    if (var(VAR_RESULT) == 1){
        setvar(VAR_0x8004, 0)
	    call(Common_EventScript_NameReceivedPartyMon)
    }
    else{
        msgbox("No worries! You can nickname your
        Pokémon anytime from the menu.", MSGBOX_AUTOCLOSE)
    }
    fadescreenswapbuffers(FADE_TO_BLACK)
    playse(SE_BALL_OPEN)
    delay(60)
    special(RemoveCameraObject)
    removeobject(popplio2)
    removeobject(popplioshiny2)
    removeobject(litten2)
    removeobject(littenshiny2)
    removeobject(rowlet2)
    removeobject(rowletshiny2) 
    special(SpawnCameraObject)
    speakername("Kukui")
    fadescreenswapbuffers(FADE_FROM_BLACK)
    msgbox("So you went with {STR_VAR_1}!
    Woo, what a fine-looking team you
    two are!
    
    Now that you can have Pokémon battles,
    you're what we call a Pokémon Trainer!
    
    Here's a Poké Ball for {STR_VAR_1},
    too.
    
    It should feel nice and cozy in there.")
    playfanfare(MUS_OBTAIN_ITEM)
    setflag(FLAG_SUPPRESS_SPEAKER_NAME)
    msgbox("Received {STR_VAR_1}'s Poké Ball!", MSGBOX_AUTOCLOSE)
    clearflag(FLAG_SUPPRESS_SPEAKER_NAME)
    speakername("Kukui")
    msgbox("All right! Then let's get going up
    to Iki Town, {PLAYER}.
    
    Woo!
    
    Time to meet the {COLOR RED}Island Kahuna{COLOR DARK_GRAY}!")
    dynmultichoice(18,8,TRUE, 5, 0, DYN_MULTICHOICE_CB_NONE, "Island Kahuna?!", "But why?!")
        if(var(VAR_RESULT) == 0)
        {
            applymovement(LOCALID_PLAYER, moves(walk_in_place_right*2))
            waitmovement(LOCALID_PLAYER)
            msgbox("Truth is, that partner {STR_VAR_1}
            of yours is a gift from the kahuna,
            not me.

            So let's go show it off and say a
            proper thank-you, cousin.

            It may not be the only gift you
            get!
            
            In case you hadn't heard, the
            kahunas are all crazy-strong
            Pokémon Trainers.
            
            Be careful about getting into a
            battle with one!", MSGBOX_AUTOCLOSE)
        }
        else
        {
            applymovement(LOCALID_PLAYER, moves(walk_in_place_right*2))
            waitmovement(LOCALID_PLAYER)
            msgbox("Truth is, that partner {STR_VAR_1}
            of yours is a gift from the kahuna,
            not me.

            So let's go show it off and say a
            proper thank-you, cousin.

            It may not be the only gift you
            get!
            
            In case you hadn't heard, the
            kahunas are all crazy-strong
            Pokémon Trainers.
            
            Be careful about getting into a
            battle with one!", MSGBOX_AUTOCLOSE)
        }
    applymovement(kukuistarters, moves(walk_down*1, walk_left *7))
    applymovement(LOCALID_PLAYER, moves(delay_16*4, walk_down*2, walk_left *6))
    applymovement(OBJ_EVENT_ID_CAMERA, moves(delay_16*4, walk_down*2, walk_left *6))
    waitmovement(0)
    clearflag(FLAG_HIDE_KUKUI_STARTERS)
    applymovement(kukuistarters, moves(face_down))
    waitmovement(kukuistarters)
    msgbox("Iki Town is right up here!", MSGBOX_AUTOCLOSE)
    applymovement(kukuistarters, moves(face_left))
    waitmovement(kukuistarters)
    delay(30)
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_fast_left*15, walk_diag_northwest*3))
    waitmovement(OBJ_EVENT_ID_CAMERA)
    delay(90)
    fadescreenswapbuffers(FADE_TO_BLACK)
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_faster_right*18, walk_faster_down*3))
    setobjectxy(kukuistarters, 21, 19)
    waitmovement(OBJ_EVENT_ID_CAMERA)
    special(RemoveCameraObject)
    addobject(techguy)
    clearflag(FLAG_TEMP_2)
    setvar(VAR_STARTERS_STATE, 1)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    release
    end
}

script Route1NN_BackOutOfStarter{
    speakername("Kukui")
    msgbox("Go on and choose the one you'd like
    to keep as your partner, cousin!")
    dynmultichoice(22,6,TRUE, 5, 0, DYN_MULTICHOICE_CB_NONE, "{COLOR GREEN}Rowlet", "{COLOR RED}Litten", "{COLOR BLUE}Popplio")
    switch(var(VAR_RESULT)){
    case 0:
        speakername("Kukui")
        msgbox("Rowlet can fly up on its enemies real
        quiet like and catch 'em by surprise!
        
        So, you wanna go with the Grass-type
        Pokémon Rowlet?", MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES){
            if (var(VAR_TEMP_3) == SHINY_MODE_ALWAYS){
                setflag(FLAG_RIVAL_SHINY)
            }
            if (var(VAR_TEMP_2) == SHINY_MODE_ALWAYS){
                setflag(FLAG_KUKUI_SHINY)
            }
            if (var(VAR_TEMP_1) == SHINY_MODE_ALWAYS){
                givemon(SPECIES_ROWLET, 5, shinyMode=SHINY_MODE_ALWAYS)
                applymovement(rowletshiny2, moves(walk_down, walk_right, face_down))
                waitmovement(rowletshiny2)
                playmoncry(SPECIES_ROWLET, 0)
                applymovement(rowletshiny2, moves(face_left, delay_16, face_up, delay_16, face_right, delay_16, face_down))
                waitmovement(rowletshiny2)
                delay(30)
                playse(SE_PIN)
                applymovement(rowletshiny2, moves(emote_heart))
                waitmovement(rowletshiny2)
                delay(60)
            }
            else{
                givemon(SPECIES_ROWLET, 5, shinyMode=SHINY_MODE_NEVER)
                applymovement(rowlet2, moves(walk_down, walk_right, face_down))
                waitmovement(rowlet2)
                playmoncry(SPECIES_ROWLET, 0)
                applymovement(rowlet2, moves(face_left, delay_16, face_up, delay_16, face_right, delay_16, face_down))
                waitmovement(rowlet2)
                delay(30)
                playse(SE_PIN)
                applymovement(rowlet2, moves(emote_heart))
                waitmovement(rowlet2)
                delay(60)
            }
            setvar(VAR_STARTER_MON, 0)
            break
        }
        else{
            speakername("Kukui")
            msgbox("I know the feeling, cousin\.
            I had a real hard time choosing once,
            too.")
            call(Route1NN_BackOutOfStarter)
        }
    case 1: 
        speakername("Kukui")
        msgbox("Litten may use Fire-type moves, but
        it's one cool cat!
        
        So, you wanna go with the Fire-type
        Pokémon Litten?", MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES){
            if (var(VAR_TEMP_3) == SHINY_MODE_ALWAYS){
                setflag(FLAG_KUKUI_SHINY)
            }
            if (var(VAR_TEMP_1) == SHINY_MODE_ALWAYS){
                setflag(FLAG_RIVAL_SHINY)
            }
            if (var(VAR_TEMP_2) == SHINY_MODE_ALWAYS){
                givemon(SPECIES_LITTEN, 5, shinyMode=SHINY_MODE_ALWAYS)
                applymovement(littenshiny2, moves(walk_down))
                waitmovement(littenshiny2)
                playmoncry(SPECIES_LITTEN, 0)
                waitse
                playse(SE_LEDGE)
                applymovement(littenshiny2, moves(jump_in_place_down))
                waitmovement(littenshiny2)
                delay(30)
                playse(SE_PIN)
                applymovement(littenshiny2, moves(emote_heart))
                waitmovement(littenshiny2)
                delay(60)
            }
            else{
                givemon(SPECIES_LITTEN, 5, shinyMode=SHINY_MODE_NEVER)
                applymovement(litten2, moves(walk_down))
                waitmovement(litten2)
                playmoncry(SPECIES_LITTEN, 0)
                waitse
                playse(SE_LEDGE)
                applymovement(litten2, moves(jump_in_place_down))
                waitmovement(litten2)
                delay(30)
                playse(SE_PIN)
                applymovement(litten2, moves(emote_heart))
                waitmovement(litten2)
                delay(60)
            }
            setvar(VAR_STARTER_MON, 1)
            break
        }
        else{
            speakername("Kukui")
            msgbox("I know the feeling, cousin\.
            I had a real hard time choosing once,
            too.")
            call(Route1NN_BackOutOfStarter)
        }
    case 2: 
        speakername("Kukui")
        msgbox("Popplio works hard and makes some
        pretty awesome balloons!
        
        So, you wanna go with the Water-type
        Pokémon Popplio?", MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES){
            if (var(VAR_TEMP_2) == SHINY_MODE_ALWAYS){
                setflag(FLAG_RIVAL_SHINY)
            }
            if (var(VAR_TEMP_1) == SHINY_MODE_ALWAYS){
                setflag(FLAG_KUKUI_SHINY)
            }
            if (var(VAR_TEMP_3) == SHINY_MODE_ALWAYS){
                givemon(SPECIES_POPPLIO, 5, shinyMode=SHINY_MODE_ALWAYS)
                applymovement(popplioshiny2, moves(walk_down, walk_left, face_down))
                waitmovement(popplioshiny2)
                playmoncry(SPECIES_POPPLIO, 0)
                waitse
                playse(SE_LEDGE)
                applymovement(popplioshiny2, moves(jump_in_place_down))
                waitmovement(popplioshiny2)
                delay(30)
                playse(SE_PIN)
                applymovement(popplioshiny2, moves(emote_heart))
                waitmovement(popplioshiny2)
                delay(60)
            }
            else{
                givemon(SPECIES_POPPLIO, 5, shinyMode=SHINY_MODE_NEVER)
                applymovement(popplio2, moves(walk_down, walk_left, face_down))
                waitmovement(popplio2)
                playmoncry(SPECIES_POPPLIO, 0)
                waitse
                playse(SE_LEDGE)
                applymovement(popplio2, moves(jump_in_place_down))
                waitmovement(popplio2)
                delay(30)
                playse(SE_PIN)
                applymovement(popplio2, moves(emote_heart))
                waitmovement(popplio2)
                delay(60)
            }
            setvar(VAR_STARTER_MON, 2)
            break
        }
        else{
            speakername("Kukui")
            msgbox("I know the feeling, cousin\.
            I had a real hard time choosing once,
            too.")
            call(Route1NN_BackOutOfStarter)
        }
    }
    bufferleadmonspeciesname(STR_VAR_1)
    applymovement(kukuistarters, moves(face_left))
    applymovement(LOCALID_PLAYER, moves(face_right))
    waitmovement(0)
    msgbox("Would you like to nickname your
    {STR_VAR_1}?", MSGBOX_YESNO)
    if (var(VAR_RESULT) == 1){
        setvar(VAR_0x8004, 0)
	    call(Common_EventScript_NameReceivedPartyMon)
    }
    else{
        msgbox("No worries! You can nickname your
        Pokémon anytime from the menu.", MSGBOX_AUTOCLOSE)
    }
    fadescreenswapbuffers(FADE_TO_BLACK)
    playse(SE_BALL_OPEN)
    delay(60)
    special(RemoveCameraObject)
    removeobject(popplio2)
    removeobject(popplioshiny2)
    removeobject(litten2)
    removeobject(littenshiny2)
    removeobject(rowlet2)
    removeobject(rowletshiny2) 
    special(SpawnCameraObject)
    speakername("Kukui")
    fadescreenswapbuffers(FADE_FROM_BLACK)
    msgbox("So you went with {STR_VAR_1}!
    Woo, what a fine-looking team you
    two are!
    
    Now that you can have Pokémon battles,
    you're what we call a Pokémon Trainer!
    
    Here's a Poké Ball for {STR_VAR_1},
    too.
    
    It should feel nice and cozy in there.")
    playfanfare(MUS_OBTAIN_ITEM)
    setflag(FLAG_SUPPRESS_SPEAKER_NAME)
    msgbox("Received {STR_VAR_1}'s Poké Ball!", MSGBOX_AUTOCLOSE)
    clearflag(FLAG_SUPPRESS_SPEAKER_NAME)
    speakername("Kukui")
    msgbox("All right! Then let's get going up
    to Iki Town, {PLAYER}.
    
    Woo!
    
    Time to meet the {COLOR RED}Island Kahuna!")
    dynmultichoice(18,8,TRUE, 5, 0, DYN_MULTICHOICE_CB_NONE, "Island Kahuna?!", "But why?!")
        if(var(VAR_RESULT) == 0)
        {
            applymovement(LOCALID_PLAYER, moves(walk_in_place_right*2))
            waitmovement(LOCALID_PLAYER)
            msgbox("Truth is, that partner {STR_VAR_1}
            of yours is a gift from the kahuna,
            not me.

            So let's go show it off and say a
            proper thank-you, cousin.

            It may not be the only gift you
            get!
            
            In case you hadn't heard, the
            kahunas are all crazy-strong
            Pokémon Trainers.
            
            Be careful about getting into a
            battle with one!", MSGBOX_AUTOCLOSE)
        }
        else
        {
            applymovement(LOCALID_PLAYER, moves(walk_in_place_right*2))
            waitmovement(LOCALID_PLAYER)
            msgbox("Truth is, that partner {STR_VAR_1}
            of yours is a gift from the kahuna,
            not me.

            So let's go show it off and say a
            proper thank-you, cousin.

            It may not be the only gift you
            get!
            
            In case you hadn't heard, the
            kahunas are all crazy-strong
            Pokémon Trainers.
            
            Be careful about getting into a
            battle with one!", MSGBOX_AUTOCLOSE)
        }
    applymovement(kukuistarters, moves(walk_down*1, walk_left *7))
    applymovement(LOCALID_PLAYER, moves(delay_16*4, walk_down*2, walk_left *6))
    applymovement(OBJ_EVENT_ID_CAMERA, moves(delay_16*4, walk_down*2, walk_left *6))
    waitmovement(0)
    clearflag(FLAG_HIDE_KUKUI_STARTERS)
    applymovement(kukuistarters, moves(face_down))
    waitmovement(kukuistarters)
    msgbox("Iki Town is right up here!", MSGBOX_AUTOCLOSE)
    applymovement(kukuistarters, moves(face_left))
    waitmovement(kukuistarters)
    delay(30)
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_fast_left*15, walk_diag_northwest*3))
    waitmovement(OBJ_EVENT_ID_CAMERA)
    delay(90)
    fadescreenswapbuffers(FADE_TO_BLACK)
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_faster_right*18, walk_faster_down*3))
    setobjectxy(kukuistarters, 21, 19)
    waitmovement(OBJ_EVENT_ID_CAMERA)
    special(RemoveCameraObject)
    addobject(techguy)
    clearflag(FLAG_TEMP_2)
    setvar(VAR_STARTERS_STATE, 1)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    release
    end
