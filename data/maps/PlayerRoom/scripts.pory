mapscripts PlayerRoom_MapScripts{
    MAP_SCRIPT_ON_TRANSITION{
        call_if_set(FLAG_LILLIE_INTRO_PLAYED, PlayerRoom_SetBoxOpen)
        end
        }
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE[FLAG_LILLIE_INTRO_PLAYED, FALSE {applymovement(LOCALID_PLAYER, moves(face_up))
    hideobjectat(PlayerRoomMeowth, MAP_PLAYER_ROOM)
    setflag(FLAG_MOM_IN_HOUSE_INTRO)}]
    MAP_SCRIPT_ON_FRAME_TABLE[VAR_MOM_IN_HOUSE_INTRO, 0: RoomIntroSequence]
}

script PlayerRoom_Wii{
    lock
    msgbox("A Wii console…{PAUSE 0x0F}{PAUSE 0x0F}{PAUSE 0x0F}
    but now isn't the time for games!")
    release
    end
}

script PlayerRoom_AdventureGuide{
    lock
    helpwindow(HELP_ADVENTURE_GUIDE)
    release
    end
}

script PlayerRoom_SetBoxOpen{
    setmaplayoutindex(LAYOUT_PLAYER_ROOM_OPEN_BOX)
    return
}

script RoomIntroSequence{
    lock
    applymovement(PlayerRoomMeowth, moves(walk_faster_up))
    waitmovement(0)
    delay(30)
    playse(SE_DOOR)
    showobjectat(PlayerRoomMeowth, MAP_PLAYER_ROOM)
    delay(30)
    applymovement(PlayerRoomMeowth, moves(walk_up*2, walk_right*2, face_up))
    waitmovement(PlayerRoomMeowth)
    playmoncry(SPECIES_MEOWTH, 0)
    msgbox("Mwaaawwwrrrrrrrr!!!", MSGBOX_AUTOCLOSE)
    waitmessage
    waitse
    playse(SE_PIN)
    applymovement(LOCALID_PLAYER, Common_Movement_ExclamationMark)
    waitmovement(LOCALID_PLAYER)
    applymovement(LOCALID_PLAYER, moves(face_down))
    delay(60)
    applymovement(PlayerRoomMeowth, moves(walk_left*2, walk_down*2))
    waitmovement(PlayerRoomMeowth)
    playse(SE_DOOR)
    hideobjectat(PlayerRoomMeowth, MAP_PLAYER_ROOM)
    waitse
    applymovement(PlayerRoomMeowth, moves(walk_down))
    waitmovement(0)
    setvar(VAR_MOM_IN_HOUSE_INTRO, 1)
    release
    end
}

script PlayerRoom_CheckBox{
    lock
    if (var(VAR_MOM_IN_HOUSE_INTRO)==1){
        msgbox("A box of stuff brought from Kanto.
        You should probably unpack it.")
    }
    elif(var(VAR_MOM_IN_HOUSE_INTRO)==2){
        setmetatile(15, 12, METATILE_PlayerHouse2_OpenBox , TRUE)
        special(DrawWholeMapView)
        msgbox("You checked the box…")
        waitmessage
        delay(30)
        playfanfare(MUS_OBTAIN_ITEM)
        msgbox("And grabbed your running shoes!", MSGBOX_AUTOCLOSE)
        setflag(FLAG_SYS_B_DASH)
        setflag(FLAG_LILLIE_INTRO_PLAYED)
        clearflag(FLAG_MOM_IN_HOUSE_INTRO)
        setvar(VAR_MOM_IN_HOUSE_INTRO, 3)
        removeobject(PlayerRoomMeowth)
    }
    else{
        msgbox("The box is empty.
        You unpacked it already.")
    }
    release
    end
}

script PlayerRoom_Trigger_TryingToLeaveWithoutShoes{
    if(var(VAR_MOM_IN_HOUSE_INTRO) == 2){
        lock
        msgbox("Mom said you should unpack the box
        in your room to find your shoes!")
        applymovement(LOCALID_PLAYER, moves(walk_up))
        waitmovement(LOCALID_PLAYER)
        release
        end
    }   
    end
}
