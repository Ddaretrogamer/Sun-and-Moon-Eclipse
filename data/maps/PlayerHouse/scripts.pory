script PlayerHouse_Trigger_TryingToLeaveWithoutShoes{
    lock
    playse(SE_PIN)
    speakername("Mom")
    msgbox("Are you leaving without your shoes, 
    {PLAYER}?
    
    You should unpack the box in
    your room to find them!", MSGBOX_AUTOCLOSE)
    applymovement(LOCALID_PLAYER, moves(walk_up))
    waitmovement(LOCALID_PLAYER)
    release
    end
}

script PlayerHouse_Trigger_TryingToLeaveWithoutShoes2{
    lock
    applymovement(playerhousemom1, moves(face_player))
    waitmovement(playerhousemom1)
    playse(SE_PIN)
    applymovement(playerhousemom1, Common_Movement_ExclamationMark)
    waitmovement(playerhousemom1)
    speakername("Mom")
    msgbox("Where are you going, {PLAYER}?
    You should probably unpack the box in
    your room to find them!")
    applymovement(LOCALID_PLAYER, moves(walk_down))
    waitmovement(LOCALID_PLAYER)
    release
    end
}

script PlayerHouse_ShowMomPokemon{
    lock
    startcutscene(CUTSCENE_PLAYERHOUSE_SHOW_MOM_POKEMON)
    delay(30)
    applymovement(LOCALID_PLAYER, moves(walk_up*2))
    applymovement(playerhousestarter, moves(walk_up))
    waitmovement(0)
    delay(30)
    playse(SE_PIN)
    applymovement(playerhousemom3, moves(face_down, emote_exclamation_mark))
    waitmovement(playerhousemom3)
    speakername("Mom")
    msgbox("Welcome back, {PLAYER}!

    So what did you think of Kahuna Hala?")
    playse(SE_PIN)
    applymovement(playerhousemom3, moves(emote_exclamation_mark))
    waitmovement(playerhousemom3)
    msgbox("Oh! And look who you've got with you!")
    setflag(FLAG_SUPPRESS_SPEAKER_NAME)
    if (var(VAR_STARTER_MON) == 0){
        playmoncry(SPECIES_ROWLET, 0)
        applymovement(playerhousestarter, moves(emote_heart))
        msgbox("Hoo?", MSGBOX_AUTOCLOSE)
    }
    if (var(VAR_STARTER_MON) == 2){
        playmoncry(SPECIES_POPPLIO, 0)
        applymovement(playerhousestarter, moves(emote_heart))
        msgbox("Bar?", MSGBOX_AUTOCLOSE)
    }
    if (var(VAR_STARTER_MON) == 1){
        playmoncry(SPECIES_LITTEN, 0)
        applymovement(playerhousestarter, moves(emote_heart))
        msgbox("Mrawr?", MSGBOX_AUTOCLOSE)
    }
    waitmoncry
    clearflag(FLAG_SUPPRESS_SPEAKER_NAME)
    applymovement(playerhousemom3, moves(walk_up*2, walk_right*3, walk_down*4))
    waitmovement(playerhousemom3)
    speakername("Mom")
    msgbox("It came running out to help you?
    What a sweet little thing!")
    dynmultichoice(20,8,TRUE, 5, 0, DYN_MULTICHOICE_CB_NONE, "That's right", "Right on Route 1")
    if(var(VAR_RESULT) == 0)
    {
        speakername("Mom")
        msgbox("And it saved you! That's amazing.
        It must have been fate that you met!")
    }
    elif(var(VAR_RESULT) == 1){
        speakername("Mom")
        msgbox("And it saved you! That's amazing.
        It must have been fate that you met!")
    }
    speakername("Mom")
    msgbox("The two of you look great together\.
    I feel happier just looking at the
    pair of you!", MSGBOX_AUTOCLOSE)
    applymovement(playerhousemeowth3, moves(walk_left, face_down))
    waitmovement(playerhousemeowth3)
    playmoncry(SPECIES_MEOWTH, 0)
    applymovement(playerhousemeowth3, moves(walk_in_place_down*2))
    setflag(FLAG_SUPPRESS_SPEAKER_NAME)
    msgbox("Mrrrrr!", MSGBOX_AUTOCLOSE)
    waitmoncry
    waitmessage
    if (var(VAR_STARTER_MON) == 0){
        playmoncry(SPECIES_ROWLET, 0)
        applymovement(playerhousestarter, moves(emote_heart))
        msgbox("Hoo?", MSGBOX_AUTOCLOSE)
    }
    if (var(VAR_STARTER_MON) == 2){
        playmoncry(SPECIES_POPPLIO, 0)
        applymovement(playerhousestarter, moves(emote_heart))
        msgbox("Bar?", MSGBOX_AUTOCLOSE)
    }
    if (var(VAR_STARTER_MON) == 1){
        playmoncry(SPECIES_LITTEN, 0)
        applymovement(playerhousestarter, moves(emote_heart))
        msgbox("Mrawr?", MSGBOX_AUTOCLOSE)
    }
    waitmoncry
    delay(30)
    special(HealPlayerParty)
    clearflag(FLAG_SUPPRESS_SPEAKER_NAME)
    setvar(VAR_0x8000, 3)
    setvar(VAR_RESULT, 1)
    fadescreen(FADE_TO_BLACK)
    delay(30)
    playfanfare(MUS_HEAL)
    callnative(OpenScreenshotsFromScript)
    waitstate
    waitfanfare
    endcutscene
    setvar(VAR_IKITOWN_STATE, 9)
    setflag(FLAG_HIDE_PLAYERHOUSE_STARTER)
    delay(30)
    warpsilent(MAP_PLAYER_ROOM, 12, 10)
    waitstate
    release
    end
}

script PlayerHouse_ShowMomPokemonSkip{
    closemessage
    fadescreenswapbuffers(FADE_TO_BLACK)
    special(CloseScriptMenus)
    special(HideCutsceneCinematicBars)
    special(HealPlayerParty)
    setvar(VAR_IKITOWN_STATE, 9)
    setflag(FLAG_HIDE_PLAYERHOUSE_STARTER)
    warp(MAP_PLAYER_ROOM, 12, 10)
    waitstate
    release
    end
}

script PlayerHouse_TalkToMomAfterDoorbell{
    lock
    faceplayer
    if(var(VAR_IKITOWN_STATE) == 10){
        speakername("Mom")
        msgbox("Was that the doorbell?
        Go see who it is, {PLAYER}.")
    }
    else{
        specialvar(VAR_RESULT, IsPlayerPartyFullyHealed)
        if(var(VAR_RESULT) == TRUE){
            speakername("Mom")
            msgbox("Sleep does the body good!
            Traveling is a true education!
            
            And unpacking\. will be the death of me!")
        }
        else{
            speakername("Mom")
            msgbox("Have you been having a good time?
            You look a bit tired but happy.
            
            Take a little break before you head out
            there again, sweetie.", MSGBOX_AUTOCLOSE)
            fadescreenswapbuffers(FADE_TO_BLACK)
            playfanfare(MUS_HEAL)
            special(HealPlayerParty)
            waitfanfare
            fadescreenswapbuffers(FADE_FROM_BLACK)
            speakername("Mom")
            msgbox("Here, Take a Pok\e Ball, too, sweetie.
            I hope you'll encounter someone
            special today!", MSGBOX_AUTOCLOSE)
            giveitem(ITEM_POKE_BALL, 1)
        }
    }
    release
    end
}

