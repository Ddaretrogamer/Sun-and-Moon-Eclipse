    lock
    msgbox(format("Trainer Tips\pThe Pokémon that will appear first in battle will be the one you've put in\lthe left position in your Pokémon party."))
    release
end
}

script HauoliOutskirts_Battle_VsLassMadison{
    trainerbattle_single(TRAINER_LASS_MADISON, "Alola! Check out my cute Pok\emon!", "Huh! You're kinda strong, aren't you?")
    msgbox("If you see a Pokémon Trainer, you've\ngotta show off the Pokémon you like!", MSGBOX_AUTOCLOSE)
    release
    end
}

script HauoliOutskirts_Battle_VsSwimmerNatasha{
    trainerbattle_single(TRAINER_SWIMMER_NATASHA, "The calm sea, or the stormy sea\.\nWhich do you prefer?", "I guess I prefer calm, at least for my\nopponents\.")
    msgbox("I like the sea in any of its moods\.
    It's always the same ocean, after all.", MSGBOX_AUTOCLOSE)
    release
    end
}
script HauoliOustkirtsFishingSpot1{
    lock
    if(var(VAR_SURF_MON_SLOT)==0)
    {
        msgbox("Would you like to fish here?", MSGBOX_YESNO)
        if (var(VAR_RESULT) == TRUE)
        {
            checkitem(ITEM_SUPER_ROD)
            if(var(VAR_RESULT) == TRUE)
            {
                startfishing
            }
            else{
                msgbox("You don't have a Fishing Rod.")
            }
        }
        else{
            release
            end
        }
    }
    else
    {
        msgbox("You can't fish while riding a Sharpedo!")
    }
    release
end
}
