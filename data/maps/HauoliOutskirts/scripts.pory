    lock
    msgbox("Pokémon Research Lab")
    release
end
}

script OutsideTenCarrotHill{
    lock
    faceplayer
    msgbox(format("Wa ha ha!\nYou're a strong Trainer, all right!\lGo on! You take on Ten Carrot Hill, friend!\pEven stronger Pokémon await you within!"))
    release
end
}
