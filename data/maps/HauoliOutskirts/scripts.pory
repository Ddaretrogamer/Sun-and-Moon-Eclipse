mapscripts HauoliOutskirts_MapScripts{
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE[VAR_IKITOWN_STATE, 20 {setflag(FLAG_HIDE_MAP_NAME_POPUP)}]
    MAP_SCRIPT_ON_FRAME_TABLE[VAR_IKITOWN_STATE, 20: HauoliOutskirts_ExitLabEclipse]
}


script HauoliOutskirts_ExitLabEclipse{
    lock
    hideobjectat(kukui_outside_lab, MAP_HAUOLI_OUTSKIRTS)
    applymovement(kukui_outside_lab, moves(walk_down*2))
    waitmovement(kukui_outside_lab)
    clearflag(FLAG_HIDE_MAP_NAME_POPUP)
    startcutscene(CUTSCENE_HAUOLI_OUTSKIRTS_EXIT_LAB_ECLIPSE)
    playse(SE_PIN)
    applymovement(lillie_outside_lab, moves(face_up, emote_exclamation_mark))
    waitmovement(lillie_outside_lab)
    delay(30)
    applymovement(lillie_outside_lab, moves(delay_8, walk_left, face_right))
    applymovement(LOCALID_PLAYER, moves(delay_16, walk_down*2, face_left))
    waitmovement(0)
    delay(30)
    opendoor(25, 12)
    waitdooranim()
    showobjectat(kukui_outside_lab, MAP_HAUOLI_OUTSKIRTS)
    applymovement(kukui_outside_lab, moves(walk_down))
    waitmovement(kukui_outside_lab)
    closedoor(25, 12)
    waitdooranim()
    applymovement(lillie_outside_lab, moves(face_up))
    applymovement(LOCALID_PLAYER, moves(face_up))
    waitmovement(0)
    delay(60)
    applymovement(lillie_outside_lab, moves(face_right))
    applymovement(LOCALID_PLAYER, moves(face_left))
    waitmovement(0)
    speakername("Lillie")
    msgbox("The Pok\emon Center is practically right
    next to your house, isn't it?")
    setweather(WEATHER_SHADE)
    doweather
    special(WaitWeather)
    fadeoutbgm(1)
    msgbox("Ah\.", MSGBOX_AUTOCLOSE)
    delay(30)
    endcutscene
    gettimeofday
    if((var(VAR_0x8000) == TIME_NIGHT) || (var(VAR_0x8000) == TIME_EVENING)){
        openscreenshot(4, 0)
    }
    else{
        openscreenshot(5, 0)
    }
    startcutscene(CUTSCENE_HAUOLI_OUTSKIRTS_EXIT_LAB_ECLIPSE)
    delay(30)
    setweather(WEATHER_NONE)
    doweather
    special(WaitWeather)
    fadeinbgm(1)
    delay(60)
    setflag(FLAG_SUPPRESS_SPEAKER_NAME)
    playmoncry(SPECIES_COSMOG, 0)
    msgbox("Pew\.")
    waitmoncry
    clearflag(FLAG_SUPPRESS_SPEAKER_NAME)
    speakername("Lillie")
    gettimeofday
    if((var(VAR_0x8000) == TIME_NIGHT) || (var(VAR_0x8000) == TIME_EVENING)){
        msgbox("Nebby\.
        {PAUSE_UNTIL_PRESS}Don't worry-it's OK.
        
        This must be what they call a lunar
        eclipse. It happens when the moon
        gets covered up.")
        applymovement(kukui_outside_lab, moves(walk_in_place_down*2))
        waitmovement(0)
        speakername("Kukui")
        msgbox("Was a lunar eclipse forcast for today?

        Ah, well. It must be some kind of
        good omen, yeah!")
    }
    else{
        msgbox("Nebby\.
        {PAUSE_UNTIL_PRESS}Don't worry-it's OK.
        
        This must be what they call a solar
        eclipse. It happens when the sun
        gets covered up.")
        applymovement(kukui_outside_lab, moves(walk_in_place_down*2))
        waitmovement(0)
        speakername("Kukui")
        msgbox("Was a solar eclipse forcast for today?
        
        Ah, well. It must be some kind of
        good omen, yeah!")
    }
    applymovement(lillie_outside_lab, moves(face_up))
    applymovement(LOCALID_PLAYER, moves(face_up))
    waitmovement(0)
    speakername("Lillie")
    msgbox("An omen?
    You think something good will happen?")
    applymovement(kukui_outside_lab, moves(jump_in_place_down*2))
    playse(SE_LEDGE)
    waitse
    playse(SE_LEDGE)
    waitse
    waitmovement(0)
    speakername("Kukui")
    msgbox("Sure! A long, long time ago, Alola was
    cloaked in darkness, yeah\.
    
    But people say that's when Alola's
    people and Pok\emon blasted all that
    darkness away with light!
    
    And they also say that was why people
    started gathering Z-Crystals, and
    that custom turned into the island
    challenge.", MSGBOX_AUTOCLOSE)
    applymovement(kukui_outside_lab, moves(jump_in_place_down*2))
    playse(SE_LEDGE)
    waitse
    playse(SE_LEDGE)
    waitse
    waitmovement(0)
    speakername("Kukui")
    msgbox("{PLAYER}!
    
    Now that you've got that Z-Power Ring,
    I hope you'll collect tons of
    Z-Crystals! Woo!
    
    That's exactly what a move researcher
    like me needs to uncover new secrets!")
    checkplayergender
    if (var(VAR_RESULT) == MALE)
    {
        speakername("Lillie")
        msgbox("Professor, that's not why he's supposed
        to be doing it\.")
        applymovement(lillie_outside_lab, moves(face_right))
        applymovement(LOCALID_PLAYER, moves(face_left))
        waitmovement(0)
        msgbox("Come on, {PLAYER}.
        I'll show you to the Pok\emon Center.", MSGBOX_AUTOCLOSE)
    }
    else
    {
        speakername("Lillie")
        msgbox("Professor, that's not why she's
        supposed to be doing it\.")
        applymovement(lillie_outside_lab, moves(face_right))
        applymovement(LOCALID_PLAYER, moves(face_left))
        waitmovement(0)
        msgbox("Come on, {PLAYER}.
        I'll show you to the Trainer's School.", MSGBOX_AUTOCLOSE)
    }
    endcutscene
    fadescreenswapbuffers(FADE_TO_BLACK)
    removeobject(lillie_outside_lab)
    setflag(FLAG_HIDE_LILLIE_HAUOLI_LAB)
    applymovement(kukui_outside_lab, moves(walk_faster_up*3))
    waitmovement(kukui_outside_lab)
    hideobjectat(kukui_outside_lab, MAP_HAUOLI_OUTSKIRTS)
    delay(30)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    setvar(VAR_IKITOWN_STATE, 21)
    release
    end
}


script HauoliOutskirts_ExitLabEclipseSkip{
    closemessage
    fadescreenswapbuffers(FADE_TO_BLACK)
    setweather(WEATHER_NONE)
    removeobject(lillie_outside_lab)
    setflag(FLAG_HIDE_LILLIE_HAUOLI_LAB)
    setobjectxy(kukui_outside_lab, 25, 10)
    hideobjectat(kukui_outside_lab, MAP_HAUOLI_OUTSKIRTS)
    special(StopAllObjectMovements)
    special(CloseScriptMenus)
    setvar(VAR_IKITOWN_STATE, 21)
    doweather
    delay(30)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    release
    end
}

