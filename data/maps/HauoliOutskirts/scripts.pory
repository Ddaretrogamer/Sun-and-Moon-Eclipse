    lock
    msgbox("Ten Carrot Hill")
    release
end
}
script HauoliOutskirtLittleGirlNPC{
    lock
    faceplayer
    msgbox(format("The Pokémon I've got with me are all\nGrass-type.\pI'm looking for Water-type Pokémon\lfor my team so I can beat Fire types,\ltoo."))
    release
end
}

